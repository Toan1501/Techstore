{% extends 'adbase.html.twig' %}

{% block title %}Quản lý mã giảm giá{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Mã giảm giá ({{ items|length }})</h6>
            <a href="{{ path('admin_coupon_new') }}" class="btn btn-sm btn-success"><i class="fas fa-plus"></i> Thêm mã</a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead><tr><th>Mã</th><th>Giảm</th><th>Đơn tối thiểu</th><th>Kích hoạt</th><th>Hết hạn</th><th>Thao tác</th></tr></thead>
                    <tbody>
                        {% for c in items %}
                        <tr>
                            <td><strong>{{ c.code }}</strong></td>
                            <td>{{ c.label }}</td>
                            <td>{{ c.minOrder|vnd }}</td>
                            <td>{% if c.active %}<span class="badge badge-success">Bật</span>{% else %}<span class="badge badge-secondary">Tắt</span>{% endif %}</td>
                            <td>{{ c.expiresAt ? c.expiresAt|date('d/m/Y H:i') : 'Vô hạn' }}</td>
                            <td class="text-nowrap">
                                <a href="{{ path('admin_coupon_edit', {'id': c.id}) }}" class="btn btn-sm btn-warning">Sửa</a>
                                <form method="post" action="{{ path('admin_coupon_delete', {'id': c.id}) }}" class="d-inline" onsubmit="return confirm('Xóa mã này?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_coupon_' ~ c.id) }}">
                                    <button class="btn btn-sm btn-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr><td colspan="6" class="text-center text-muted">Chưa có mã giảm giá.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
