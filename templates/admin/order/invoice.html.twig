<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Hóa đơn #{{ order.id }}</title>
    <style>
        * { font-family: 'Segoe UI', Arial, sans-serif; }
        body { max-width: 780px; margin: 20px auto; color: #222; }
        .head { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 3px solid #e30019; padding-bottom: 12px; }
        .brand { font-size: 26px; font-weight: 800; color: #e30019; }
        h1 { font-size: 20px; margin: 16px 0 4px; }
        table { width: 100%; border-collapse: collapse; margin: 14px 0; }
        th, td { border: 1px solid #ddd; padding: 8px; font-size: 14px; }
        th { background: #f4f4f4; text-align: left; }
        .totals td { border: none; padding: 4px 8px; }
        .totals .grand { font-size: 18px; font-weight: 700; color: #e30019; }
        .muted { color: #666; font-size: 13px; }
        .no-print { margin: 16px 0; }
        @media print { .no-print { display: none; } body { margin: 0; } }
    </style>
</head>
<body>
    {% set st = store_settings() %}
    <div class="no-print">
        <button onclick="window.print()">🖨️ In hóa đơn</button>
        <a href="{{ path('admin_order_invoice_pdf', {'id': order.id}) }}">⬇️ Tải PDF</a>
        <a href="{{ path('admin_order_detail', {'id': order.id}) }}">← Quay lại</a>
    </div>

    <div class="head">
        <div>
            <div class="brand">{{ st.storeName }}</div>
            <div class="muted">{{ st.address }}<br>Hotline: {{ st.hotline }} · {{ st.email }}</div>
        </div>
        <div style="text-align:right">
            <h1>HÓA ĐƠN #{{ order.id }}</h1>
            <div class="muted">Ngày: {{ order.createdAt ? order.createdAt|date('d/m/Y H:i') : '' }}</div>
        </div>
    </div>

    <p><strong>Khách hàng:</strong> {{ order.customerName }} — {{ order.customerPhone }}<br>
       <strong>Địa chỉ:</strong> {{ order.fullAddress }}<br>
       <strong>Thanh toán:</strong> {{ order.paymentMethodLabel }} ({{ order.paid ? 'Đã thanh toán' : 'Chưa thanh toán' }})</p>

    <table>
        <thead><tr><th>#</th><th>Sản phẩm</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr></thead>
        <tbody>
            {% for item in order.items %}
            <tr>
                <td>{{ loop.index }}</td>
                <td>{{ item.product ? item.product.name : '(đã xóa)' }}</td>
                <td>{{ item.price|vnd }}</td>
                <td>{{ item.quantity }}</td>
                <td>{{ item.total|vnd }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <table class="totals" style="width:auto; margin-left:auto">
        <tr><td>Tạm tính:</td><td style="text-align:right">{{ order.subtotal|vnd }}</td></tr>
        {% if order.discount > 0 %}<tr><td>Giảm giá:</td><td style="text-align:right">-{{ order.discount|vnd }}</td></tr>{% endif %}
        <tr><td>Phí vận chuyển:</td><td style="text-align:right">{{ order.shippingFee == 0 ? 'Miễn phí' : order.shippingFee|vnd }}</td></tr>
        <tr class="grand"><td>TỔNG CỘNG:</td><td style="text-align:right">{{ order.totalPrice|vnd }}</td></tr>
    </table>

    <p class="muted" style="text-align:center; margin-top:30px">Cảm ơn quý khách đã mua hàng tại {{ st.storeName }}!</p>
</body>
</html>
