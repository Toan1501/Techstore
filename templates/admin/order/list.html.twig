{% extends 'adbase.html.twig' %}

{% block title %}Đơn hàng{% endblock %}
{% block subtitle %}{{ orders.getTotalItemCount }} đơn phù hợp · bấm vào một dòng để xem chi tiết{% endblock %}
{% block actions %}
    <a href="{{ path('admin_orders_export') }}" class="btn ad-btn ad-btn--ghost"><i class="bi bi-filetype-csv"></i> Xuất CSV</a>
{% endblock %}

{% block body %}
{% set labels = {'pending':'Chờ xử lý','confirmed':'Đã xác nhận','shipping':'Đang giao','completed':'Hoàn thành','cancelled':'Đã hủy'} %}
{% set keep = {'q': filters.q, 'from': filters.from, 'to': filters.to} %}
<section class="ad-card">
    <div class="ad-filters">
        <div class="ad-chips">
            <a href="{{ path('admin_order_list', keep|filter(v => v)) }}" class="ad-chip{{ not filters.status ? ' is-on' : '' }}">Tất cả <b>{{ status_counts|reduce((c, v) => c + v, 0) }}</b></a>
            {% for value, color in statuses %}
                <a href="{{ path('admin_order_list', keep|merge({'status': value})|filter(v => v)) }}" class="ad-chip{{ filters.status == value ? ' is-on' : '' }}">{{ labels[value] }} <b>{{ status_counts[value] ?? 0 }}</b></a>
            {% endfor %}
        </div>
    </div>
    <form method="get" class="ad-filters" data-autosubmit>
        {% if filters.status %}<input type="hidden" name="status" value="{{ filters.status }}">{% endif %}
        <div class="ad-filters__search">
            <i class="bi bi-search"></i>
            <input type="search" name="q" value="{{ filters.q }}" class="form-control" placeholder="Mã đơn, tên khách, SĐT hoặc email" aria-label="Tìm đơn hàng">
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="ad-muted small">Từ</span>
            <input type="date" name="from" value="{{ filters.from }}" class="form-control" style="width:160px" aria-label="Từ ngày">
            <span class="ad-muted small">đến</span>
            <input type="date" name="to" value="{{ filters.to }}" class="form-control" style="width:160px" aria-label="Đến ngày">
        </div>
        <button type="submit" class="btn ad-btn ad-btn--ghost">Lọc</button>
        {% if filters.q or filters.from or filters.to or filters.status %}<a href="{{ path('admin_order_list') }}" class="ad-muted small">Xóa bộ lọc</a>{% endif %}
    </form>

    <div class="ad-table-wrap">
        <table class="ad-table">
            <thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Thanh toán</th><th class="num">Sản phẩm</th><th class="num">Tổng tiền</th><th>Trạng thái</th><th>Ngày đặt</th><th class="actions"></th></tr></thead>
            <tbody>
                {% for order in orders %}
                    {% set url = path('admin_order_detail', {'id': order.id}) %}
                    <tr data-href="{{ url }}">
                        <td><a href="{{ url }}" class="ad-strong">#{{ order.id }}</a></td>
                        <td><div class="ad-strong">{{ order.customerName }}</div><div class="ad-muted small">{{ order.customerPhone }}</div></td>
                        <td>
                            <div class="small">{{ order.paymentMethodLabel }}</div>
                            {% if order.paid %}<span class="ad-pill ad-pill--success ad-pill--nodot">Đã thanh toán</span>{% elseif order.paymentMethod in ['momo', 'vnpay'] %}<span class="ad-pill ad-pill--warning ad-pill--nodot">Chờ thanh toán</span>{% endif %}
                        </td>
                        <td class="num">{{ order.items|length }}</td>
                        <td class="num ad-price">{{ order.totalPrice|vnd }}</td>
                        <td><span class="ad-pill ad-pill--{{ order.statusColor }}">{{ order.statusLabel }}</span></td>
                        <td class="ad-muted">{{ order.createdAt ? order.createdAt|date('d/m/Y H:i') : '—' }}</td>
                        <td class="actions">
                            <div class="ad-row-actions">
                                <a href="{{ path('admin_order_invoice', {'id': order.id}) }}" target="_blank" rel="noopener" class="ad-icon-btn" title="In hóa đơn" aria-label="In hóa đơn #{{ order.id }}"><i class="bi bi-printer"></i></a>
                                <a href="{{ url }}" class="ad-icon-btn" title="Chi tiết" aria-label="Chi tiết #{{ order.id }}"><i class="bi bi-chevron-right"></i></a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="8"><div class="ad-empty"><i class="bi bi-inbox"></i><b>Không tìm thấy đơn hàng</b>Thử đổi trạng thái hoặc khoảng ngày.</div></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% if orders.haveToPaginate is defined and orders.haveToPaginate %}
        <div class="ad-card__foot d-flex justify-content-end">{{ knp_pagination_render(orders, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}</div>
    {% endif %}
</section>
{% endblock %}
