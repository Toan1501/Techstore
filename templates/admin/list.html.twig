{% extends 'adbase.html.twig' %}

{% block title %}Danh sách sản phẩm{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Sản phẩm ({{ data|length }})</h6>
            <a href="{{ path('app_san_pham') }}" class="btn btn-sm btn-success"><i class="fas fa-plus"></i> Thêm sản phẩm</a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr><th>STT</th><th>Mã</th><th>Ảnh</th><th>Tên sản phẩm</th><th>Giá</th><th>Kho</th><th>Thao tác</th></tr>
                    </thead>
                    <tbody>
                        {% for sp in data %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td>{{ sp.getId() }}</td>
                            <td><img src="{{ asset('uploads/sanpham/' ~ sp.getPhoto()) }}" height="56" alt=""></td>
                            <td>{{ sp.getName() }}</td>
                            <td class="text-danger fw-semibold">{{ sp.getPrice()|vnd }}</td>
                            <td>{{ sp.getStock() }}</td>
                            <td class="text-nowrap">
                                <a href="{{ path('app_edit_san_pham', {'id': sp.getId()}) }}" class="btn btn-sm btn-warning">Sửa</a>
                                <form method="post" action="{{ path('app_delete_san_pham', {'id': sp.getId()}) }}" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_product_' ~ sp.getId()) }}">
                                    <button class="btn btn-sm btn-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>function deletesp(url){ if(confirm("Bạn có chắc muốn xóa sản phẩm này?")){ window.location.href = url; } }</script>
{% endblock %}
