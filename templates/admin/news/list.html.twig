{% extends 'adbase.html.twig' %}

{% block title %}Tin tức{% endblock %}
{% block subtitle %}{{ items|length }} bài viết{% endblock %}
{% block actions %}<a href="{{ path('admin_news_new') }}" class="btn ad-btn ad-btn--red"><i class="bi bi-plus-lg"></i> Viết bài mới</a>{% endblock %}

{% block body %}
<section class="ad-card">
    <div class="ad-table-wrap">
        <table class="ad-table">
            <thead><tr><th>Bài viết</th><th>Đường dẫn</th><th>Ngày đăng</th><th class="actions"></th></tr></thead>
            <tbody>
                {% for n in items %}
                    {% set edit = path('admin_news_edit', {'id': n.id}) %}
                    <tr data-href="{{ edit }}">
                        <td>
                            <div class="ad-prod">
                                <img class="ad-thumb ad-thumb--wide" style="height:54px" src="{{ asset(n.image ?: 'images/og-image.jpg') }}" alt="">
                                <div class="min-w-0"><a href="{{ edit }}" class="ad-prod__name">{{ n.title }}</a>{% if n.excerpt %}<div class="ad-prod__meta" style="max-width:520px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ n.excerpt }}</div>{% endif %}</div>
                            </div>
                        </td>
                        <td class="ad-muted small ad-mono">/tin-tuc/{{ n.slug }}</td>
                        <td class="ad-muted">{{ n.createdAt ? n.createdAt|date('d/m/Y') : '' }}</td>
                        <td class="actions">
                            <div class="ad-row-actions">
                                <a href="{{ path('app_news_detail', {'slug': n.slug}) }}" target="_blank" rel="noopener" class="ad-icon-btn" title="Xem" aria-label="Xem"><i class="bi bi-eye"></i></a>
                                <a href="{{ edit }}" class="ad-icon-btn" title="Sửa" aria-label="Sửa"><i class="bi bi-pencil"></i></a>
                                <form method="post" action="{{ path('admin_news_delete', {'id': n.id}) }}" data-confirm="Xóa bài “{{ n.title }}”?" data-confirm-ok="Xóa bài viết">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_news_' ~ n.id) }}">
                                    <button class="ad-icon-btn ad-icon-btn--danger" title="Xóa" aria-label="Xóa"><i class="bi bi-trash3"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4"><div class="ad-empty"><i class="bi bi-newspaper"></i><b>Chưa có bài viết</b><a href="{{ path('admin_news_new') }}">Viết bài đầu tiên</a></div></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endblock %}
