{% extends 'adbase.html.twig' %}

{% block title %}Duyệt đánh giá{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="card shadow mb-4">
        <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Đánh giá ({{ items|length }})</h6></div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead><tr><th>Sản phẩm</th><th>Người dùng</th><th>Điểm</th><th>Nội dung</th><th>Ngày</th><th>Thao tác</th></tr></thead>
                    <tbody>
                        {% for rv in items %}
                        <tr>
                            <td>{{ rv.product ? rv.product.name : '(đã xóa)' }}</td>
                            <td>{{ rv.user ? rv.user.username : '—' }}</td>
                            <td class="text-nowrap">{% for i in 1..5 %}<i class="fas fa-star" style="color:{{ i <= rv.rating ? '#f5a623' : '#ddd' }}"></i>{% endfor %}</td>
                            <td style="max-width:420px">{{ rv.comment }}</td>
                            <td>{{ rv.createdAt ? rv.createdAt|date('d/m/Y') : '' }}</td>
                            <td>
                                <form method="post" action="{{ path('admin_review_delete', {'id': rv.id}) }}" onsubmit="return confirm('Xóa đánh giá này?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_review_' ~ rv.id) }}">
                                    <button class="btn btn-sm btn-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr><td colspan="6" class="text-center text-muted">Chưa có đánh giá.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
