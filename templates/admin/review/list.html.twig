{% extends 'adbase.html.twig' %}

{% block title %}Đánh giá sản phẩm{% endblock %}
{% set avg = items|length ? (items|reduce((c, r) => c + r.rating, 0) / items|length) : 0 %}
{% block subtitle %}{{ items|length }} đánh giá · điểm trung bình {{ avg|number_format(1, ',') }}/5{% endblock %}

{% block body %}
<section class="ad-card">
    <div class="ad-table-wrap">
        <table class="ad-table">
            <thead><tr><th>Sản phẩm</th><th>Khách hàng</th><th>Đánh giá</th><th>Nội dung</th><th>Ngày</th><th class="actions"></th></tr></thead>
            <tbody>
                {% for rv in items %}
                    <tr>
                        <td>
                            {% if rv.product %}
                                <div class="ad-prod" style="min-width:200px">
                                    <img class="ad-thumb" src="{{ asset('uploads/sanpham/' ~ rv.product.photo) }}" alt="">
                                    <a class="ad-prod__name" href="{{ path('app_product', {'slug': rv.product.slug, 'id': rv.product.id}) }}" target="_blank" rel="noopener">{{ rv.product.name }}</a>
                                </div>
                            {% else %}<span class="ad-muted">(sản phẩm đã xóa)</span>{% endif %}
                        </td>
                        <td>{{ rv.user ? '@' ~ rv.user.username : '—' }}</td>
                        <td><span class="ad-stars">{% for i in 1..5 %}<i class="bi bi-star-fill{{ i > rv.rating ? ' off' : '' }}"></i>{% endfor %}</span></td>
                        <td style="max-width:420px">{{ rv.comment ?: '—' }}</td>
                        <td class="ad-muted">{{ rv.createdAt ? rv.createdAt|date('d/m/Y') : '' }}</td>
                        <td class="actions">
                            <form method="post" action="{{ path('admin_review_delete', {'id': rv.id}) }}" data-confirm="Xóa đánh giá này? Điểm trung bình của sản phẩm sẽ được tính lại." data-confirm-ok="Xóa đánh giá">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_review_' ~ rv.id) }}">
                                <button class="ad-icon-btn ad-icon-btn--danger" title="Xóa" aria-label="Xóa đánh giá"><i class="bi bi-trash3"></i></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6"><div class="ad-empty"><i class="bi bi-star"></i><b>Chưa có đánh giá</b></div></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endblock %}
