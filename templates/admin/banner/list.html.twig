{% extends 'adbase.html.twig' %}

{% block title %}Quản lý banner{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Banner ({{ items|length }})</h6>
            <a href="{{ path('admin_banner_new') }}" class="btn btn-sm btn-success"><i class="fas fa-plus"></i> Thêm banner</a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead><tr><th>Ảnh</th><th>Tiêu đề</th><th>Liên kết</th><th>Thứ tự</th><th>Hiển thị</th><th>Thao tác</th></tr></thead>
                    <tbody>
                        {% for b in items %}
                        <tr>
                            <td><img src="{{ asset(b.image) }}" height="46" alt=""></td>
                            <td>{{ b.title }}</td>
                            <td class="text-muted small">{{ b.link ?: '—' }}</td>
                            <td>{{ b.position }}</td>
                            <td>{% if b.active %}<span class="badge badge-success">Bật</span>{% else %}<span class="badge badge-secondary">Tắt</span>{% endif %}</td>
                            <td class="text-nowrap">
                                <a href="{{ path('admin_banner_edit', {'id': b.id}) }}" class="btn btn-sm btn-warning">Sửa</a>
                                <form method="post" action="{{ path('admin_banner_delete', {'id': b.id}) }}" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa banner này?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_banner_' ~ b.id) }}">
                                    <button class="btn btn-sm btn-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr><td colspan="6" class="text-center text-muted">Chưa có banner.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>function delItem(u){ if(confirm("Bạn có chắc muốn xóa banner này?")){ window.location.href=u; } }</script>
{% endblock %}
