{% extends 'adbase.html.twig' %}

{% block title %}Banner trang chủ{% endblock %}
{% block subtitle %}{{ items|filter(b => b.active)|length }} banner đang hiển thị · sắp theo thứ tự tăng dần{% endblock %}
{% block actions %}<a href="{{ path('admin_banner_new') }}" class="btn ad-btn ad-btn--red"><i class="bi bi-plus-lg"></i> Thêm banner</a>{% endblock %}

{% block body %}
<section class="ad-card">
    <div class="ad-table-wrap">
        <table class="ad-table">
            <thead><tr><th>Banner</th><th>Liên kết</th><th class="num">Thứ tự</th><th>Hiển thị</th><th class="actions"></th></tr></thead>
            <tbody>
                {% for b in items %}
                    {% set edit = path('admin_banner_edit', {'id': b.id}) %}
                    <tr data-href="{{ edit }}">
                        <td>
                            <div class="ad-prod">
                                <img class="ad-thumb ad-thumb--wide" src="{{ asset(b.image) }}" alt="" style="height:40px">
                                <a href="{{ edit }}" class="ad-prod__name">{{ b.title ?: 'Banner #' ~ b.id }}</a>
                            </div>
                        </td>
                        <td class="ad-muted small ad-mono">{{ b.link ?: '—' }}</td>
                        <td class="num ad-strong">{{ b.position }}</td>
                        <td>{% if b.active %}<span class="ad-pill ad-pill--success">Đang hiện</span>{% else %}<span class="ad-pill ad-pill--muted">Ẩn</span>{% endif %}</td>
                        <td class="actions">
                            <div class="ad-row-actions">
                                <a href="{{ edit }}" class="ad-icon-btn" title="Sửa" aria-label="Sửa"><i class="bi bi-pencil"></i></a>
                                <form method="post" action="{{ path('admin_banner_delete', {'id': b.id}) }}" data-confirm="Xóa banner này khỏi trang chủ?" data-confirm-ok="Xóa banner">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_banner_' ~ b.id) }}">
                                    <button class="ad-icon-btn ad-icon-btn--danger" title="Xóa" aria-label="Xóa"><i class="bi bi-trash3"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5"><div class="ad-empty"><i class="bi bi-images"></i><b>Chưa có banner</b><a href="{{ path('admin_banner_new') }}">Thêm banner đầu tiên</a></div></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endblock %}
