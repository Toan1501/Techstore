{% extends 'adbase.html.twig' %}

{% block title %}Tin nhắn liên hệ{% endblock %}
{% block subtitle %}{{ items|length }} tin nhắn từ form liên hệ{% endblock %}

{% block body %}
<section class="ad-card">
    {% for c in items %}
        <article class="ad-qa">
            <div class="ad-qa__meta">
                <span class="ad-user__av" style="width:32px;height:32px;border-radius:9px;font-size:.85rem">{{ c.name|first|upper }}</span>
                <b class="text-body">{{ c.name }}</b><span>·</span><a href="mailto:{{ c.email }}">{{ c.email }}</a>
                <div class="ms-auto d-flex gap-2">
                    <a href="mailto:{{ c.email }}?subject={{ ('Phản hồi từ TOÀN STORE')|url_encode }}" class="btn ad-btn ad-btn--ghost ad-btn--sm"><i class="bi bi-reply"></i> Trả lời qua email</a>
                    <form method="post" action="{{ path('admin_contact_delete', {'id': c.id}) }}" data-confirm="Xóa tin nhắn của {{ c.name }}?" data-confirm-ok="Xóa">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_contact_' ~ c.id) }}">
                        <button class="ad-icon-btn ad-icon-btn--danger" title="Xóa" aria-label="Xóa tin nhắn"><i class="bi bi-trash3"></i></button>
                    </form>
                </div>
            </div>
            <div style="white-space:pre-line">{{ c.message }}</div>
        </article>
    {% else %}
        <div class="ad-empty"><i class="bi bi-envelope-open"></i><b>Hộp thư trống</b>Tin nhắn từ trang Liên hệ sẽ xuất hiện ở đây.</div>
    {% endfor %}
</section>
{% endblock %}
