{% extends 'adbase.html.twig' %}

{% block title %}Tin nhắn liên hệ{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="card shadow mb-4">
        <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Tin nhắn liên hệ ({{ items|length }})</h6></div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead><tr><th>Họ tên</th><th>Email</th><th>Nội dung</th><th>Thao tác</th></tr></thead>
                    <tbody>
                        {% for c in items %}
                        <tr>
                            <td>{{ c.name }}</td>
                            <td><a href="mailto:{{ c.email }}">{{ c.email }}</a></td>
                            <td style="max-width:520px">{{ c.message }}</td>
                            <td class="text-nowrap">
                                <form method="post" action="{{ path('admin_contact_delete', {'id': c.id}) }}" onsubmit="return confirm('Xóa tin nhắn này?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_contact_' ~ c.id) }}">
                                    <button class="btn btn-sm btn-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr><td colspan="4" class="text-center text-muted">Chưa có tin nhắn nào.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
