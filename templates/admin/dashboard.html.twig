{% extends 'adbase.html.twig' %}

{% block title %}Bảng điều khiển{% endblock %}

{% block body %}
{% set statusLabels = {'pending':'Chờ xử lý','confirmed':'Đã xác nhận','shipping':'Đang giao','completed':'Hoàn thành','cancelled':'Đã hủy'} %}
<div class="container-fluid mt-4">
    <h1 class="h3 mb-4 text-gray-800">Bảng điều khiển</h1>

    {# ==== Stat cards ==== #}
    <div class="row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body"><div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Doanh thu (hoàn thành)</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">{{ revenue|vnd }}</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-money-bill-wave fa-2x text-gray-300"></i></div>
                </div></div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body"><div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Tổng đơn hàng</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">{{ total_orders }}</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-shopping-bag fa-2x text-gray-300"></i></div>
                </div></div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body"><div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Đơn chờ xử lý</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">{{ pending_orders }}</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-clock fa-2x text-gray-300"></i></div>
                </div></div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body"><div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Sản phẩm / Danh mục</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">{{ total_products }} / {{ total_categories }}</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-boxes fa-2x text-gray-300"></i></div>
                </div></div>
            </div>
        </div>
    </div>

    {# ==== Revenue chart ==== #}
    <div class="card shadow mb-4">
        <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Doanh thu 14 ngày gần đây</h6></div>
        <div class="card-body"><div style="height:300px"><canvas id="revChart"></canvas></div></div>
    </div>

    <div class="row">
        {# ==== Order status breakdown ==== #}
        <div class="col-lg-5 mb-4">
            <div class="card shadow h-100">
                <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Trạng thái đơn hàng</h6></div>
                <div class="card-body">
                    {% for value, color in statuses %}
                        {% set cnt = status_map[value] ?? 0 %}
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span>{{ statusLabels[value] }}</span><span class="fw-bold">{{ cnt }}</span>
                            </div>
                            <div class="progress" style="height:8px">
                                <div class="progress-bar bg-{{ color }}" role="progressbar" style="width: {{ total_orders > 0 ? (cnt / total_orders * 100)|round : 0 }}%"></div>
                            </div>
                        </div>
                    {% endfor %}
                    <div class="text-muted small mt-2">Khách hàng đã đăng ký: <strong>{{ total_users }}</strong></div>
                </div>
            </div>
        </div>

        {# ==== Recent orders ==== #}
        <div class="col-lg-7 mb-4">
            <div class="card shadow h-100">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Đơn hàng gần đây</h6>
                    <a href="{{ path('admin_order_list') }}" class="btn btn-sm btn-primary">Xem tất cả</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 align-middle">
                            <thead><tr><th>Mã</th><th>Khách hàng</th><th>Tổng</th><th>Trạng thái</th><th></th></tr></thead>
                            <tbody>
                                {% for o in recent_orders %}
                                <tr>
                                    <td>#{{ o.id }}</td>
                                    <td>{{ o.customerName }}</td>
                                    <td class="text-danger fw-semibold">{{ o.totalPrice|vnd }}</td>
                                    <td><span class="badge badge-{{ o.statusColor }}">{{ o.statusLabel }}</span></td>
                                    <td><a href="{{ path('admin_order_detail', {'id': o.id}) }}" class="btn btn-sm btn-outline-primary">Xem</a></td>
                                </tr>
                                {% else %}
                                <tr><td colspan="5" class="text-center text-muted">Chưa có đơn hàng.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ==== Low stock ==== #}
    <div class="card shadow mb-4">
        <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-warning"><i class="fas fa-exclamation-triangle"></i> Sản phẩm sắp hết hàng (≤ 5)</h6></div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <thead><tr><th>Ảnh</th><th>Tên sản phẩm</th><th>Giá</th><th>Tồn kho</th><th></th></tr></thead>
                    <tbody>
                        {% for sp in low_stock %}
                        <tr>
                            <td><img src="{{ asset('uploads/sanpham/' ~ sp.getPhoto()) }}" height="40" alt=""></td>
                            <td>{{ sp.getName() }}</td>
                            <td>{{ sp.getPrice()|vnd }}</td>
                            <td><span class="badge badge-{{ sp.getStock() == 0 ? 'danger' : 'warning' }}">{{ sp.getStock() }}</span></td>
                            <td><a href="{{ path('app_edit_san_pham', {'id': sp.getId()}) }}" class="btn btn-sm btn-outline-warning">Cập nhật</a></td>
                        </tr>
                        {% else %}
                        <tr><td colspan="5" class="text-center text-muted">Tất cả sản phẩm đều còn đủ hàng.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(function () {
    var el = document.getElementById('revChart');
    if (!el || typeof Chart === 'undefined') return;
    new Chart(el, {
        type: 'line',
        data: {
            labels: {{ chart_labels|json_encode|raw }},
            datasets: [{
                label: 'Doanh thu (₫)',
                data: {{ chart_values|json_encode|raw }},
                borderColor: '#e30019',
                backgroundColor: 'rgba(227,0,25,.10)',
                fill: true,
                tension: .3,
                pointBackgroundColor: '#e30019'
            }]
        },
        options: {
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { callback: function (v) { return new Intl.NumberFormat('vi-VN').format(v); } } } }
        }
    });
})();
</script>
{% endblock %}
