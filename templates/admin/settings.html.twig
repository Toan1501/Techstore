{% extends 'adbase.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Cài đặt cửa hàng{% endblock %}
{% block subtitle %}Thông tin hiển thị ở header, footer, hóa đơn và trang thanh toán.{% endblock %}

{% block body %}
{{ form_start(form) }}
<div class="ad-grid-even ad-mb">
    <section class="ad-card">
        <div class="ad-card__body">
            <h2 class="ad-section-title"><i class="bi bi-shop"></i> Thông tin cửa hàng</h2>
            {{ form_row(form.storeName) }}
            <div class="row g-3">
                <div class="col-md-6">{{ form_row(form.hotline) }}</div>
                <div class="col-md-6">{{ form_row(form.email) }}</div>
            </div>
            {{ form_row(form.address) }}
        </div>
    </section>
    <div>
        <section class="ad-card">
            <div class="ad-card__body">
                <h2 class="ad-section-title"><i class="bi bi-bank"></i> Chuyển khoản ngân hàng</h2>
                {{ form_row(form.bankName) }}
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.bankAccount, {'attr': {'class': 'ad-mono'}}) }}</div>
                    <div class="col-md-6">{{ form_row(form.bankOwner) }}</div>
                </div>
            </div>
        </section>
        <section class="ad-card mb-0">
            <div class="ad-card__body">
                <h2 class="ad-section-title"><i class="bi bi-truck"></i> Phí vận chuyển</h2>
                {{ form_row(form.freeShipThreshold, {'attr': {'data-money': ''}}) }}
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.shipFeeInner, {'attr': {'data-money': ''}}) }}</div>
                    <div class="col-md-6">{{ form_row(form.shipFeeOuter, {'attr': {'data-money': ''}}) }}</div>
                </div>
            </div>
        </section>
    </div>
</div>
{{ form_rest(form) }}
<div class="ad-savebar">
    <button type="submit" class="btn ad-btn ad-btn--red"><i class="bi bi-check2"></i> Lưu cài đặt</button>
</div>
{{ form_end(form) }}
{% endblock %}
