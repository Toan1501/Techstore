{% extends 'base.html.twig' %}
{% form_theme order_form 'bootstrap_5_layout.html.twig' %}

{% block title %}Thanh toán — TOÀN STORE{% endblock %}

{% block body %}
<div class="container-fluid px-3 px-xl-5 py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('app_cart') }}" class="text-decoration-none">Giỏ hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thanh toán</li>
        </ol>
    </nav>

    {{ form_start(order_form) }}
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="checkout-card">
                <div class="checkout-card__head"><i class="bi bi-truck"></i> Thông tin giao hàng</div>
                <div class="checkout-card__body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_label(order_form.customer_name) }}
                            <div class="input-group ts-field"><span class="input-group-text"><i class="bi bi-person"></i></span>{{ form_widget(order_form.customer_name, {attr: {class: 'form-control'}}) }}</div>
                            {{ form_errors(order_form.customer_name) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(order_form.customer_phone) }}
                            <div class="input-group ts-field"><span class="input-group-text"><i class="bi bi-telephone"></i></span>{{ form_widget(order_form.customer_phone, {attr: {class: 'form-control'}}) }}</div>
                            {{ form_errors(order_form.customer_phone) }}
                        </div>
                        <div class="col-12">
                            {{ form_label(order_form.customer_email) }}
                            <div class="input-group ts-field"><span class="input-group-text"><i class="bi bi-envelope"></i></span>{{ form_widget(order_form.customer_email, {attr: {class: 'form-control'}}) }}</div>
                            {{ form_errors(order_form.customer_email) }}
                        </div>
                        <div class="col-md-4">{{ form_row(order_form.shipping_province) }}</div>
                        <div class="col-md-4">{{ form_row(order_form.shipping_district) }}</div>
                        <div class="col-md-4">{{ form_row(order_form.shipping_ward) }}</div>
                        <div class="col-12">
                            {{ form_label(order_form.customer_address) }}
                            <div class="input-group ts-field"><span class="input-group-text"><i class="bi bi-geo-alt"></i></span>{{ form_widget(order_form.customer_address, {attr: {class: 'form-control'}}) }}</div>
                            {{ form_errors(order_form.customer_address) }}
                        </div>
                        <div class="col-12">{{ form_row(order_form.note) }}</div>
                    </div>
                </div>
            </div>

            <div class="checkout-card">
                <div class="checkout-card__head"><i class="bi bi-credit-card"></i> Phương thức thanh toán</div>
                <div class="checkout-card__body">
                    <div class="ts-payments">{{ form_widget(order_form.payment_method) }}</div>
                    {{ form_errors(order_form.payment_method) }}
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card checkout-summary">
                <div class="card-header fw-semibold">Đơn hàng của bạn ({{ cart_manager.totalItems }})</div>
                <div class="card-body">
                    <div style="max-height:240px;overflow:auto">
                        {% for item in cart_manager.items %}
                        <div class="d-flex justify-content-between small py-1">
                            <span class="line-clamp-1 me-2">{{ item.product.name }} &times; {{ item.quantity }}</span>
                            <span class="text-nowrap">{{ item.getAmount()|vnd }}</span>
                        </div>
                        {% endfor %}
                    </div>
                    <div class="input-group input-group-sm my-2">
                        <input type="text" name="coupon_code" class="form-control" placeholder="Mã giảm giá" value="{{ applied_coupon ? applied_coupon.code : '' }}">
                        {% if applied_coupon %}
                            <button class="btn btn-outline-secondary" type="submit" formaction="{{ path('app_cart_coupon_remove') }}" formmethod="get" formnovalidate>Bỏ</button>
                        {% else %}
                            <button class="btn btn-outline-danger" type="submit" formaction="{{ path('app_cart_coupon') }}" formnovalidate>Áp dụng</button>
                        {% endif %}
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Tạm tính</span><span id="sum-subtotal">{{ cart_manager.amount|vnd }}</span>
                    </div>
                    {% if applied_coupon %}
                    <div class="d-flex justify-content-between mb-1 text-success">
                        <span>Giảm giá ({{ applied_coupon.code }})</span><span>-{{ discount|vnd }}</span>
                    </div>
                    {% endif %}
                    <div class="d-flex justify-content-between mb-1">
                        <span>Phí vận chuyển</span><span id="sum-shipping" class="text-muted">Chọn tỉnh/thành</span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold fs-5 mt-2">
                        <span>Tổng cộng</span><span id="sum-total" class="text-danger">{{ (cart_manager.amount - discount)|vnd }}</span>
                    </div>
                    <p class="text-muted small mt-2 mb-0">Miễn phí vận chuyển cho đơn từ {{ free_ship_threshold|vnd }}.</p>
                    <button type="submit" class="btn btn-danger btn-lg-cta w-100 mt-3"><i class="bi bi-bag-check"></i> ĐẶT HÀNG</button>
                </div>
            </div>
        </div>
    </div>
    {{ form_end(order_form) }}
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var subtotal = {{ cart_manager.amount }};
    var discount = {{ discount }};
    var threshold = {{ free_ship_threshold }};
    var feeMap = {{ shipping_fee_map|json_encode|raw }};
    var provinceSel = document.getElementById('order_form_shipping_province');
    var shipEl = document.getElementById('sum-shipping');
    var totalEl = document.getElementById('sum-total');

    function vnd(n) { return new Intl.NumberFormat('vi-VN').format(Math.round(n)) + ' ₫'; }

    function update() {
        if (!provinceSel || !provinceSel.value) { shipEl.textContent = 'Chọn tỉnh/thành'; totalEl.textContent = vnd(subtotal - discount); return; }
        var fee = subtotal >= threshold ? 0 : (feeMap[provinceSel.value] || 0);
        shipEl.textContent = fee === 0 ? 'Miễn phí' : vnd(fee);
        totalEl.textContent = vnd(subtotal - discount + fee);
    }
    if (provinceSel) { provinceSel.addEventListener('change', update); update(); }
})();
</script>
{% endblock %}
