{% extends 'base.html.twig' %}

{% block title %}Câu hỏi thường gặp (FAQ) — TOÀN STORE{% endblock %}
{% block meta_description %}Giải đáp các câu hỏi thường gặp khi mua hàng tại Toàn Store: hàng chính hãng, giao hàng, đổi trả, bảo hành, trả góp và thanh toán.{% endblock %}

{% block body %}
<script type="application/ld+json">{{ {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    'mainEntity': faqs|map(f => {
        '@type': 'Question', 'name': f.q,
        'acceptedAnswer': {'@type': 'Answer', 'text': f.a}
    })
}|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>

<div class="container-fluid px-3 px-xl-5 py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Câu hỏi thường gặp</li>
        </ol>
    </nav>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="gv-section">
                <h1 class="h4 mb-3">Câu hỏi thường gặp</h1>
                <div class="accordion" id="faqAcc">
                    {% for f in faqs %}
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button {{ loop.first ? '' : 'collapsed' }}" type="button" data-bs-toggle="collapse" data-bs-target="#faq{{ loop.index }}">
                                {{ f.q }}
                            </button>
                        </h2>
                        <div id="faq{{ loop.index }}" class="accordion-collapse collapse {{ loop.first ? 'show' : '' }}" data-bs-parent="#faqAcc">
                            <div class="accordion-body">{{ f.a }}</div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="gv-section">
                <div class="gv-section__head"><h2 style="font-size:1rem">Thông tin &amp; chính sách</h2></div>
                <div class="list-group list-group-flush">
                    {% for key, p in pages %}
                        <a href="{{ path(p.route) }}" class="list-group-item list-group-item-action">{{ p.nav }}</a>
                    {% endfor %}
                    <a href="{{ path('page_faq') }}" class="list-group-item list-group-item-action active">Câu hỏi thường gặp</a>
                    <a href="{{ path('app_contact') }}" class="list-group-item list-group-item-action">Liên hệ</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
