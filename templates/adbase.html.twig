<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Quản trị{% endblock %} · TOÀN STORE Admin</title>
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('images/favicon-32.png') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="{{ asset('css/admin.css') }}" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
    <script>try { if (localStorage.getItem('ad-collapsed') === '1') document.documentElement.classList.add('ad-collapsed'); } catch (e) {}</script>
</head>
<body>
{% set route = app.request.attributes.get('_route') %}
{% set cnt = admin_counts() %}
{% set nav = [
    {'group': 'Tổng quan', 'items': [
        {'label': 'Bảng điều khiển', 'icon': 'grid-1x2', 'route': 'app_admin', 'match': ['app_admin']},
        {'label': 'Báo cáo bán hàng', 'icon': 'graph-up-arrow', 'fill': false, 'route': 'admin_reports', 'match': ['admin_reports']},
    ]},
    {'group': 'Bán hàng', 'items': [
        {'label': 'Đơn hàng', 'icon': 'bag-check', 'route': 'admin_order_list', 'match': ['admin_order_list', 'admin_order_detail'], 'badge': cnt.pending_orders},
        {'label': 'Mã giảm giá', 'icon': 'ticket-perforated', 'route': 'admin_coupon_list', 'match': ['admin_coupon_list', 'admin_coupon_new', 'admin_coupon_edit']},
    ]},
    {'group': 'Sản phẩm', 'items': [
        {'label': 'Sản phẩm', 'icon': 'box-seam', 'route': 'app_ds_san_pham', 'match': ['app_ds_san_pham', 'app_san_pham', 'app_edit_san_pham'], 'badge': cnt.low_stock, 'badge_tone': 'amber', 'badge_title': 'sắp hết hàng'},
        {'label': 'Danh mục', 'icon': 'diagram-3', 'route': 'app_ds_category', 'match': ['app_ds_category', 'ad_category', 'app_edit_category']},
    ]},
    {'group': 'Nội dung', 'items': [
        {'label': 'Banner trang chủ', 'icon': 'images', 'fill': false, 'route': 'admin_banner_list', 'match': ['admin_banner_list', 'admin_banner_new', 'admin_banner_edit']},
        {'label': 'Tin tức', 'icon': 'newspaper', 'fill': false, 'route': 'admin_news_list', 'match': ['admin_news_list', 'admin_news_new', 'admin_news_edit']},
    ]},
    {'group': 'Khách hàng', 'items': [
        {'label': 'Người dùng', 'icon': 'people', 'route': 'admin_user_list', 'match': ['admin_user_list']},
        {'label': 'Đánh giá', 'icon': 'star', 'route': 'admin_review_list', 'match': ['admin_review_list']},
        {'label': 'Hỏi đáp', 'icon': 'chat-left-dots', 'route': 'admin_question_list', 'match': ['admin_question_list'], 'badge': cnt.open_questions},
        {'label': 'Liên hệ', 'icon': 'envelope', 'route': 'admin_contact_list', 'match': ['admin_contact_list'], 'badge': cnt.contacts, 'badge_tone': 'cream'},
    ]},
    {'group': 'Hệ thống', 'items': [
        {'label': 'Cài đặt cửa hàng', 'icon': 'sliders', 'fill': false, 'route': 'admin_settings', 'match': ['admin_settings']},
    ]},
] %}

<div class="ad-shell">
    {# ===== Sidebar ===== #}
    <aside class="ad-side offcanvas-lg offcanvas-start" tabindex="-1" id="adSide" aria-label="Điều hướng quản trị">
        <div class="ad-side__brand">
            <a href="{{ path('app_admin') }}" class="ad-side__logo" aria-label="Bảng điều khiển">
                {% include 'partials/_logo.html.twig' with {tone: 'dark', compact: true} %}
            </a>
            <span class="ad-side__tag">Admin</span>
            <button type="button" class="btn-close d-lg-none ms-auto" data-bs-dismiss="offcanvas" data-bs-target="#adSide" aria-label="Đóng"></button>
        </div>
        <nav class="ad-nav">
            {% for g in nav %}
                <div class="ad-nav__group">{{ g.group }}</div>
                {% for it in g.items %}
                    {% set on = route in it.match %}
                    <a href="{{ path(it.route) }}" class="ad-nav__link{{ on ? ' is-active' : '' }}" {{ on ? 'aria-current="page"' : '' }} title="{{ it.label }}">
                        <i class="bi bi-{{ it.icon }}{{ on and (it.fill ?? true) ? '-fill' : '' }}"></i>
                        <span class="ad-nav__text">{{ it.label }}</span>
                        {% if it.badge is defined and it.badge > 0 %}
                            <span class="ad-nav__badge ad-nav__badge--{{ it.badge_tone|default('red') }}" title="{{ it.badge }} {{ it.badge_title|default('cần xử lý') }}">{{ it.badge > 99 ? '99+' : it.badge }}</span>
                        {% endif %}
                    </a>
                {% endfor %}
            {% endfor %}
        </nav>
        <div class="ad-side__foot">
            <a href="{{ path('homepage') }}" class="ad-nav__link" target="_blank" rel="noopener" title="Xem cửa hàng">
                <i class="bi bi-shop"></i><span class="ad-nav__text">Xem cửa hàng</span><i class="bi bi-box-arrow-up-right ms-auto ad-nav__text small"></i>
            </a>
            <button type="button" class="ad-collapse-btn d-none d-lg-flex" data-ad-collapse title="Thu gọn / mở rộng menu">
                <i class="bi bi-layout-sidebar-inset"></i><span class="ad-nav__text">Thu gọn menu</span>
            </button>
        </div>
    </aside>

    {# ===== Main ===== #}
    <div class="ad-main">
        <header class="ad-top">
            <button class="ad-top__icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adSide" aria-label="Mở menu"><i class="bi bi-list"></i></button>

            <form class="ad-search" action="{{ path('app_ds_san_pham') }}" method="get" role="search">
                <i class="bi bi-search"></i>
                <input type="search" name="q" placeholder="Tìm sản phẩm theo tên, SKU..." value="{{ route == 'app_ds_san_pham' ? app.request.query.get('q') : '' }}" aria-label="Tìm sản phẩm">
                <kbd class="d-none d-md-inline">/</kbd>
            </form>

            <div class="ad-top__right">
                <div class="dropdown d-none d-sm-block">
                    <button class="btn ad-btn ad-btn--red dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-plus-lg"></i> Tạo mới</button>
                    <ul class="dropdown-menu dropdown-menu-end ad-menu">
                        <li><a class="dropdown-item" href="{{ path('app_san_pham') }}"><i class="bi bi-box-seam"></i> Sản phẩm</a></li>
                        <li><a class="dropdown-item" href="{{ path('ad_category') }}"><i class="bi bi-diagram-3"></i> Danh mục</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_coupon_new') }}"><i class="bi bi-ticket-perforated"></i> Mã giảm giá</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_banner_new') }}"><i class="bi bi-images"></i> Banner</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_news_new') }}"><i class="bi bi-newspaper"></i> Bài viết</a></li>
                    </ul>
                </div>

                <div class="dropdown">
                    <button class="ad-top__icon position-relative" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Việc cần xử lý">
                        <i class="bi bi-bell"></i>
                        {% set todo = cnt.pending_orders + cnt.open_questions %}
                        {% if todo > 0 %}<span class="ad-dot">{{ todo > 9 ? '9+' : todo }}</span>{% endif %}
                    </button>
                    <div class="dropdown-menu dropdown-menu-end ad-menu ad-notif">
                        <div class="ad-notif__head">Việc cần xử lý</div>
                        <a class="dropdown-item" href="{{ path('admin_order_list', {'status': 'pending'}) }}"><span class="ad-notif__ic ad-tone--amber"><i class="bi bi-hourglass-split"></i></span><span><b>{{ cnt.pending_orders }}</b> đơn hàng chờ xác nhận</span></a>
                        <a class="dropdown-item" href="{{ path('admin_question_list') }}"><span class="ad-notif__ic ad-tone--blue"><i class="bi bi-chat-left-dots"></i></span><span><b>{{ cnt.open_questions }}</b> câu hỏi chưa trả lời</span></a>
                        <a class="dropdown-item" href="{{ path('app_ds_san_pham', {'stock': 'low'}) }}"><span class="ad-notif__ic ad-tone--red"><i class="bi bi-exclamation-triangle"></i></span><span><b>{{ cnt.low_stock }}</b> sản phẩm sắp hết hàng</span></a>
                        <a class="dropdown-item" href="{{ path('admin_contact_list') }}"><span class="ad-notif__ic ad-tone--cream"><i class="bi bi-envelope"></i></span><span><b>{{ cnt.contacts }}</b> tin nhắn liên hệ</span></a>
                    </div>
                </div>

                <a class="ad-top__icon d-none d-md-grid" href="{{ path('homepage') }}" target="_blank" rel="noopener" title="Xem cửa hàng" aria-label="Xem cửa hàng"><i class="bi bi-shop"></i></a>

                <div class="dropdown">
                    <button class="ad-user" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="ad-user__av">{{ (app.user ? app.user.userIdentifier : 'A')|first|upper }}</span>
                        <span class="ad-user__name d-none d-md-flex"><b>{{ app.user ? app.user.userIdentifier : 'Quản trị' }}</b><small>Quản trị viên</small></span>
                        <i class="bi bi-chevron-down d-none d-md-inline"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end ad-menu">
                        <li><a class="dropdown-item" href="{{ path('profile') }}"><i class="bi bi-person"></i> Tài khoản</a></li>
                        <li><a class="dropdown-item" href="{{ path('change_password') }}"><i class="bi bi-key"></i> Đổi mật khẩu</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_settings') }}"><i class="bi bi-sliders"></i> Cài đặt cửa hàng</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right"></i> Đăng xuất</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="ad-content" id="main">
            {% block page_header %}
                <div class="ad-head">
                    {% set _sub %}{% block subtitle %}{% endblock %}{% endset %}
                    <div class="ad-head__text">
                        {% block crumbs %}{% endblock %}
                        <h1>{% block heading %}{{ block('title') }}{% endblock %}</h1>
                        {% if _sub|trim is not empty %}<p>{{ _sub }}</p>{% endif %}
                    </div>
                    <div class="ad-head__actions">{% block actions %}{% endblock %}</div>
                </div>
            {% endblock %}

            {% block body %}{% endblock %}
        </main>
    </div>
</div>

{# Toast flashes #}
<div class="ad-toasts" aria-live="polite">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            {% set tone = type == 'error' ? 'danger' : type %}
            <div class="ad-toast ad-toast--{{ tone }}" role="status">
                <i class="bi bi-{{ tone == 'success' ? 'check-circle-fill' : (tone == 'danger' ? 'x-octagon-fill' : 'info-circle-fill') }}"></i>
                <span>{{ message }}</span>
                <button type="button" aria-label="Đóng" data-toast-close><i class="bi bi-x-lg"></i></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

{# Shared confirm dialog for forms/links marked with data-confirm #}
<div class="modal fade" id="adConfirm" tabindex="-1" aria-hidden="true" aria-labelledby="adConfirmTitle">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ad-modal">
            <div class="ad-modal__icon"><i class="bi bi-exclamation-triangle"></i></div>
            <h2 class="ad-modal__title" id="adConfirmTitle">Bạn chắc chắn chứ?</h2>
            <p class="ad-modal__text" data-confirm-text>Thao tác này không thể hoàn tác.</p>
            <div class="ad-modal__actions">
                <button type="button" class="btn ad-btn ad-btn--ghost" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn ad-btn ad-btn--red" data-confirm-ok>Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
<script src="{{ asset('js/admin.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
