<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}TOÀN STORE{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}TOÀN STORE — Cửa hàng máy tính, laptop, PC gaming & linh kiện chính hãng, giá tốt, trả góp 0%.{% endblock %}">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="TOÀN STORE">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="{{ block('meta_description') }}">
        <meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('images/logo.jpg')) }}{% endblock %}">
        {# Canonical keeps ?page=N (N>1) so paginated listings stay indexable; other params are dropped. #}
        {% set _pg = app.request.query.getInt('page', 1) %}
        <link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.baseUrl ~ app.request.pathInfo }}{{ _pg > 1 ? '?page=' ~ _pg : '' }}">
        {# Private / thin pages must not be indexed (cart, checkout, account, search, auth). #}
        {% set _noindex = app.request.attributes.get('_route') in ['app_cart', 'app_order', 'app_order_confirmation', 'app_login', 'app_register', 'profile', 'edit_profile', 'app_my_orders', 'app_order_detail_customer', 'app_wishlist', 'app_compare', 'search_products', 'app_forgot_password_request', 'app_check_email', 'app_reset_password'] %}
        <meta name="robots" content="{{ _noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large' }}">
        <meta name="theme-color" content="#e30019">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ block('title') }}">
        <meta name="twitter:description" content="{{ block('meta_description') }}">
        <meta name="twitter:image" content="{{ block('og_image') }}">
        {% set _st = store_settings() %}
        <script type="application/ld+json">{{ {
            '@context': 'https://schema.org', '@type': 'ElectronicsStore',
            'name': _st.storeName, 'url': url('homepage'),
            'logo': absolute_url(asset('images/logo.jpg')),
            'image': absolute_url(asset('images/logo.jpg')),
            'telephone': _st.hotline, 'email': _st.email,
            'address': {'@type': 'PostalAddress', 'streetAddress': _st.address, 'addressCountry': 'VN'},
            'priceRange': '$$'
        }|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
        <script type="application/ld+json">{{ {
            '@context': 'https://schema.org', '@type': 'WebSite',
            'name': _st.storeName, 'url': url('homepage'),
            'potentialAction': {
                '@type': 'SearchAction',
                'target': {'@type': 'EntryPoint', 'urlTemplate': url('search_products') ~ '?keyword={search_term_string}'},
                'query-input': 'required name=search_term_string'
            }
        }|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🛒</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
        <link href="{{ asset('css/techstore.css') }}" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
    {% set _cart = app.session.get('cart') %}
    {% set st = store_settings() %}

    <div id="ts-progress"></div>

    <header class="gv-header">
        <div class="gv-topbar d-none d-md-block">
            <div class="container-fluid px-3 px-xl-5">
                <div class="gv-topbar__row">
                    <div class="gv-topbar__links">
                        <a href="{{ path('feature_product') }}">Sản phẩm</a>
                        <a href="{{ path('app_news') }}">Tin tức</a>
                        <a href="{{ path('app_compare') }}">So sánh</a>
                        <a href="{{ path('app_wishlist') }}">Yêu thích</a>
                        <a href="{{ path('app_contact') }}">Liên hệ</a>
                    </div>
                    {# Promo ticker (duplicated once for a seamless loop) #}
                    {% set _tick = [
                        ['truck', 'Miễn phí vận chuyển đơn từ 5 triệu'],
                        ['lightning-charge-fill', 'Flash Sale mỗi ngày — giảm tới 25%'],
                        ['credit-card', 'Trả góp 0% qua thẻ tín dụng'],
                        ['shield-check', 'Bảo hành chính hãng · 1 đổi 1 trong 7 ngày'],
                        ['headset', 'Tư vấn cấu hình miễn phí 08:00 – 21:00']
                    ] %}
                    <div class="gv-ticker d-none d-lg-block" aria-hidden="true">
                        <div class="gv-ticker__track">
                            {% for i in 0..1 %}{% for t in _tick %}<span><i class="bi bi-{{ t[0] }}"></i>{{ t[1] }}</span>{% endfor %}{% endfor %}
                        </div>
                    </div>
                    <div class="text-nowrap"><i class="bi bi-headset me-1"></i> Hỗ trợ: <strong>{{ st.hotline }}</strong></div>
                </div>
            </div>
        </div>
        <div class="gv-header__main">
            <div class="container-fluid px-3 px-xl-5">
                <div class="gv-header__row">
                    <a href="{{ path('homepage') }}" class="gv-logo">
                        <span class="gv-logo__icon"><i class="bi bi-pc-display"></i></span>
                        <span class="gv-logo__text">
                            <span class="gv-logo__name">TOÀN <b>STORE</b></span>
                            <span class="gv-logo__tag d-none d-lg-block">Máy tính &amp; Linh kiện</span>
                        </span>
                    </a>

                    <button class="gv-menu-btn btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#catOffcanvas" aria-label="Danh mục">
                        <i class="bi bi-list"></i>
                    </button>

                    <form class="gv-search flex-grow-1 d-none d-md-block" action="{{ path('search_products') }}" method="get" style="max-width:560px">
                        <div class="input-group">
                            <input type="hidden" id="keyword" name="keyword">
                            <select id="search"></select>
                            <button type="submit" class="btn"><i class="bi bi-search"></i></button>
                        </div>
                    </form>

                    <div class="gv-icons">
                        <div class="gv-hotline gv-icon-btn d-none d-xl-flex">
                            <i class="bi bi-headset"></i>
                            <div><small>Hotline</small><strong>{{ st.hotline }}</strong></div>
                        </div>

                        <a href="{{ path('app_wishlist') }}" class="gv-icon-btn position-relative d-none d-md-flex" aria-label="Yêu thích">
                            <i class="bi bi-heart"></i>
                            <div class="d-none d-lg-block text-start"><small>Yêu</small><strong>thích</strong></div>
                            <span id="wish-count" class="gv-cart-count">{{ app.session.get('wishlist')|default([])|length }}</span>
                        </a>

                        <div class="dropdown">
                            <button class="gv-icon-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                                <div class="d-none d-lg-block text-start">
                                    <small>{{ app.user ? 'Xin chào' : 'Đăng nhập / Đăng ký' }}</small>
                                    <strong class="line-clamp-1" style="max-width:120px">{{ app.user ? app.user.userIdentifier : 'Tài khoản' }}</strong>
                                </div>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                {% if app.user %}
                                    <li><a class="dropdown-item" href="{{ path('profile') }}"><i class="bi bi-person me-2"></i>Tài khoản của tôi</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_my_orders') }}"><i class="bi bi-bag me-2"></i>Đơn hàng của tôi</a></li>
                                    {% if is_granted('ROLE_ADMIN') %}<li><a class="dropdown-item" href="{{ path('app_admin') }}"><i class="bi bi-speedometer2 me-2"></i>Trang quản trị</a></li>{% endif %}
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                                {% else %}
                                    <li><a class="dropdown-item" href="{{ path('app_login') }}">Đăng nhập</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_register') }}">Đăng ký</a></li>
                                {% endif %}
                            </ul>
                        </div>

                        <button class="gv-icon-btn position-relative" type="button" data-bs-toggle="offcanvas" data-bs-target="#miniCart" aria-label="Giỏ hàng">
                            <i class="bi bi-cart3"></i>
                            <div class="d-none d-lg-block text-start"><small>Giỏ</small><strong>hàng</strong></div>
                            <span id="cart-count" class="gv-cart-count">{{ _cart ? _cart.getTotalItems() : 0 }}</span>
                        </button>
                    </div>
                </div>

                <form class="gv-search d-md-none pb-2" action="{{ path('search_products') }}" method="get">
                    <div class="input-group">
                        <input type="text" name="keyword" class="form-control" placeholder="Bạn cần tìm gì?">
                        <button type="submit" class="btn"><i class="bi bi-search"></i></button>
                    </div>
                </form>
            </div>
        </div>

        <div class="gv-catbar d-none d-lg-block">
            <div class="container-fluid px-xl-5">
                <ul class="gv-catbar__list">
                    <li class="gv-mega">
                        <a href="{{ path('app_category') }}"><i class="bi bi-list"></i> Danh mục sản phẩm</a>
                        <div class="gv-mega__panel">
                            {% for c in all_categories() %}
                                <a href="{{ path('app_productofcate', {'id': c.id}) }}"><i class="bi bi-chevron-right"></i> {{ c.name }}</a>
                            {% endfor %}
                        </div>
                    </li>
                    {% for c in all_categories()|slice(0, 7) %}
                        <li><a href="{{ path('app_productofcate', {'id': c.id}) }}">{{ c.name }}</a></li>
                    {% endfor %}
                    <li><a href="{{ path('feature_product') }}">Tất cả sản phẩm</a></li>
                    <li><a href="{{ path('app_news') }}">Tin tức</a></li>
                    <li><a href="{{ path('app_contact') }}">Liên hệ</a></li>
                </ul>
            </div>
        </div>
    </header>

    {# ===== Categories offcanvas (mobile) ===== #}
    <div class="offcanvas offcanvas-start" tabindex="-1" id="catOffcanvas" aria-labelledby="catOffcanvasLabel">
        <div class="offcanvas-header bg-danger text-white">
            <h5 class="offcanvas-title" id="catOffcanvasLabel">Danh mục</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
        </div>
        <div class="offcanvas-body p-0">
            <div class="list-group list-group-flush">
                <a href="{{ path('homepage') }}" class="list-group-item list-group-item-action">Trang chủ</a>
                <a href="{{ path('feature_product') }}" class="list-group-item list-group-item-action">Tất cả sản phẩm</a>
                <div class="list-group-item bg-light fw-semibold text-uppercase small text-muted">Danh mục</div>
                {% for c in all_categories() %}
                    <a href="{{ path('app_productofcate', {'id': c.id}) }}" class="list-group-item list-group-item-action">{{ c.name }}</a>
                {% else %}
                    <span class="list-group-item text-muted">Chưa có danh mục</span>
                {% endfor %}
                <div class="list-group-item bg-light fw-semibold text-uppercase small text-muted">Tiện ích</div>
                <a href="{{ path('app_wishlist') }}" class="list-group-item list-group-item-action"><i class="bi bi-heart me-2"></i>Yêu thích</a>
                <a href="{{ path('app_compare') }}" class="list-group-item list-group-item-action"><i class="bi bi-arrow-left-right me-2"></i>So sánh</a>
                {% if app.user %}<a href="{{ path('app_my_orders') }}" class="list-group-item list-group-item-action"><i class="bi bi-bag me-2"></i>Đơn hàng của tôi</a>{% endif %}
                <a href="{{ path('app_news') }}" class="list-group-item list-group-item-action"><i class="bi bi-newspaper me-2"></i>Tin tức</a>
                <a href="{{ path('app_contact') }}" class="list-group-item list-group-item-action"><i class="bi bi-headset me-2"></i>Liên hệ</a>
            </div>
        </div>
    </div>

    {# ===== Mini-cart offcanvas ===== #}
    <div class="offcanvas offcanvas-end" tabindex="-1" id="miniCart" aria-labelledby="miniCartLabel">
        <div class="offcanvas-header bg-danger text-white">
            <h5 class="offcanvas-title" id="miniCartLabel">Giỏ hàng</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            {% if _cart and _cart.getTotalItems() > 0 %}
                <div class="flex-grow-1 overflow-auto">
                    {% for item in _cart.getItems() %}
                        <div class="d-flex align-items-center gap-2 py-2 border-bottom">
                            <img src="{{ asset('uploads/sanpham/' ~ item.product.photo) }}" alt="{{ item.product.name }}" style="width:48px;height:48px;flex:0 0 48px;object-fit:contain;border:1px solid var(--ts-border);border-radius:6px">
                            <div class="flex-grow-1 min-w-0">
                                <div class="line-clamp-1 small">{{ item.product.name }}</div>
                                <div class="text-muted small">{{ item.quantity }} &times; {{ item.product.price|vnd }}</div>
                            </div>
                            <form action="{{ path('app_cart_remove', {'product_id': item.product.id}) }}" method="POST">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_remove_' ~ item.product.id) }}" />
                                <button type="submit" class="btn btn-link text-muted p-0" aria-label="Xóa"><i class="bi bi-x-lg"></i></button>
                            </form>
                        </div>
                    {% endfor %}
                </div>
                <div class="d-flex justify-content-between fw-bold my-3">
                    <span>Tổng cộng</span><span class="text-danger">{{ _cart.getAmount()|vnd }}</span>
                </div>
                <a href="{{ path('app_cart') }}" class="btn btn-outline-danger mb-2">Xem giỏ hàng</a>
                <a href="{{ path('app_order') }}" class="btn btn-danger">Thanh toán</a>
            {% else %}
                <div class="text-center text-muted my-auto">
                    <i class="bi bi-cart-x" style="font-size:2.2rem"></i>
                    <p class="mt-2 mb-0">Giỏ hàng của bạn đang trống.</p>
                </div>
            {% endif %}
        </div>
    </div>

    {# Flash messages #}
    <div class="container-fluid px-3 px-xl-5 mt-3">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : (type == 'success' ? 'success' : type) }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <main>{% block body %}{% endblock %}</main>

    <footer class="gv-footer">
        <div class="container-fluid px-3 px-xl-5">
            <div class="row g-4">
                <div class="col-6 col-lg-3">
                    <h6>VỀ TOÀN STORE</h6>
                    <a href="{{ path('page_about') }}">Giới thiệu</a>
                    <a href="{{ path('app_contact') }}">Liên hệ</a>
                    <a href="{{ path('page_careers') }}">Tuyển dụng</a>
                    <a href="{{ path('app_news') }}">Tin công nghệ</a>
                </div>
                <div class="col-6 col-lg-3">
                    <h6>CHÍNH SÁCH</h6>
                    <a href="{{ path('page_warranty') }}">Chính sách bảo hành</a>
                    <a href="{{ path('page_return') }}">Chính sách đổi trả</a>
                    <a href="{{ path('page_shipping') }}">Chính sách giao hàng</a>
                    <a href="{{ path('page_privacy') }}">Bảo mật thông tin</a>
                </div>
                <div class="col-6 col-lg-3">
                    <h6>HỖ TRỢ</h6>
                    <a href="{{ path('page_buyguide') }}">Hướng dẫn mua hàng</a>
                    <a href="{{ path('page_payguide') }}">Hướng dẫn thanh toán</a>
                    <a href="{{ path('page_installment') }}">Hướng dẫn trả góp</a>
                    <a href="{{ path('page_faq') }}">Câu hỏi thường gặp</a>
                    <a href="{{ path('app_my_orders') }}">Tra cứu đơn hàng</a>
                </div>
                <div class="col-6 col-lg-3">
                    <h6>KẾT NỐI</h6>
                    <p class="small mb-1"><i class="bi bi-geo-alt text-danger"></i> {{ st.address }}</p>
                    <p class="small mb-1"><i class="bi bi-headset text-danger"></i> Hotline: <strong>{{ st.hotline }}</strong></p>
                    <p class="small mb-2"><i class="bi bi-envelope text-danger"></i> {{ st.email }}</p>
                    <div class="d-flex gap-3 fs-4 mb-2">
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                        <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    </div>
                    <div class="gv-footer__pay">
                        <span>VISA</span><span>Mastercard</span><span>MoMo</span><span>COD</span>
                    </div>
                </div>
            </div>
            <div class="gv-footer__bottom text-center">© {{ "now"|date("Y") }} TOÀN STORE — Cửa hàng máy tính &amp; linh kiện chính hãng.</div>
        </div>
    </footer>

    {# Back-to-top button (behavior in ui.js) #}
    <button id="ts-totop" type="button" aria-label="Lên đầu trang"><i class="bi bi-arrow-up"></i></button>
    {# Floating hotline button with pulse ring #}
    <a href="tel:{{ st.hotline|replace({' ': ''}) }}" id="ts-hotline" aria-label="Gọi hotline {{ st.hotline }}" title="Hotline {{ st.hotline }}"><i class="bi bi-telephone-fill"></i></a>

    <!-- jQuery (Select2) -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <!-- Bootstrap 5 bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
    <!-- Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $('#search').select2({
            width: '100%',
            placeholder: 'Bạn cần tìm gì?',
            minimumInputLength: 2,
            ajax: {
                url: "{{ path('search_api') }}",
                dataType: 'json',
                data: function (params) { $('#keyword').val(params.term); return { keyword: params.term }; },
                processResults: function (data) {
                    return { results: $.map(data, function (obj) { return { id: obj.id, text: obj.name }; }) };
                }
            }
        });
        $('#search').on('select2:select', function (e) { window.location.href = "/feature/" + e.params.data.id; });
    </script>

    {# Floating compare bar #}
    {% set _compare = app.session.get('compare')|default([]) %}
    <div id="compare-bar" class="position-fixed bottom-0 start-50 translate-middle-x mb-3 bg-dark text-white rounded-pill px-3 py-2 shadow align-items-center gap-3 {{ _compare|length == 0 ? 'd-none' : 'd-flex' }}" style="z-index:1070;">
        <span><i class="bi bi-arrow-left-right"></i> So sánh (<span id="compare-count">{{ _compare|length }}</span>)</span>
        <a href="{{ path('app_compare') }}" class="btn btn-sm btn-danger">Xem so sánh</a>
        <a href="{{ path('app_compare_clear') }}" class="text-white-50" aria-label="Xóa"><i class="bi bi-x-lg"></i></a>
    </div>

    {# Toast for AJAX add-to-cart #}
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div id="cart-toast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="cart-toast-body">Đã thêm vào giỏ.</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Đóng"></button>
            </div>
        </div>
    </div>
    <script>
    document.addEventListener('submit', function (e) {
        var form = e.target.closest('.add-to-cart-form');
        if (!form) return;
        e.preventDefault();
        fetch(form.action, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: new FormData(form) })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
            .then(function (res) {
                var toastEl = document.getElementById('cart-toast');
                var body = document.getElementById('cart-toast-body');
                if (res.ok && res.d.ok) {
                    var badge = document.getElementById('cart-count');
                    if (badge) badge.textContent = res.d.count;
                    toastEl.classList.remove('bg-danger'); toastEl.classList.add('bg-success');
                } else {
                    toastEl.classList.remove('bg-success'); toastEl.classList.add('bg-danger');
                }
                body.textContent = res.d.message || 'Có lỗi xảy ra.';
                bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 2500 }).show();
            })
            .catch(function () { window.location.href = form.action; });
    });
    // Wishlist toggle (AJAX)
    document.addEventListener('submit', function (e) {
        var form = e.target.closest('.wishlist-form');
        if (!form) return;
        e.preventDefault();
        fetch(form.action, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d.ok) return;
                var btn = form.querySelector('.gv-wish-btn');
                var icon = form.querySelector('i');
                if (btn) btn.classList.toggle('active', d.active);
                if (icon) { icon.className = 'bi ' + (d.active ? 'bi-heart-fill' : 'bi-heart'); }
                var wc = document.getElementById('wish-count'); if (wc) wc.textContent = d.count;
                var toastEl = document.getElementById('cart-toast');
                document.getElementById('cart-toast-body').textContent = d.message;
                toastEl.classList.remove('bg-danger'); toastEl.classList.add('bg-success');
                bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 2000 }).show();
            })
            .catch(function () { window.location.href = form.action; });
    });
    // Compare toggle (AJAX)
    document.addEventListener('submit', function (e) {
        var form = e.target.closest('.compare-form');
        if (!form) return;
        e.preventDefault();
        fetch(form.action, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                var toastEl = document.getElementById('cart-toast');
                document.getElementById('cart-toast-body').textContent = d.message;
                toastEl.classList.remove('bg-success', 'bg-danger'); toastEl.classList.add(d.ok ? 'bg-success' : 'bg-danger');
                bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 2000 }).show();
                if (!d.ok) return;
                var btn = form.querySelector('.gv-wish-btn'); if (btn) btn.classList.toggle('active', d.active);
                var cc = document.getElementById('compare-count'); if (cc) cc.textContent = d.count;
                var bar = document.getElementById('compare-bar'); if (bar) { bar.classList.toggle('d-none', d.count == 0); bar.classList.toggle('d-flex', d.count > 0); }
            })
            .catch(function () { window.location.href = form.action; });
    });
    </script>
    <script src="{{ asset('js/ui.js') }}"></script>
    {% block javascripts %}{% endblock %}
    </body>
</html>
