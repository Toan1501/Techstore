<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}TOÀN STORE{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}TOÀN STORE — Cửa hàng máy tính, laptop, PC gaming & linh kiện chính hãng, giá tốt, trả góp 0%.{% endblock %}">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="TOÀN STORE">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="{{ block('meta_description') }}">
        <meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('images/og-image.jpg')) }}{% endblock %}">
        {# Canonical keeps ?page=N (N>1) so paginated listings stay indexable; other params are dropped. #}
        {% set _pg = app.request.query.getInt('page', 1) %}
        <link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.baseUrl ~ app.request.pathInfo }}{{ _pg > 1 ? '?page=' ~ _pg : '' }}">
        {# Private / thin pages must not be indexed (cart, checkout, account, search, auth). #}
        {% set _noindex = app.request.attributes.get('_route') in ['app_cart', 'app_order', 'app_order_confirmation', 'app_login', 'app_register', 'profile', 'edit_profile', 'app_my_orders', 'app_order_detail_customer', 'app_wishlist', 'app_compare', 'search_products', 'app_forgot_password_request', 'app_check_email', 'app_reset_password', 'change_password'] %}
        <meta name="robots" content="{{ _noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large' }}">
        <meta name="theme-color" content="#e30019">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ block('title') }}">
        <meta name="twitter:description" content="{{ block('meta_description') }}">
        <meta name="twitter:image" content="{{ block('og_image') }}">
        {% set _st = store_settings() %}
        <script type="application/ld+json">{{ {
            '@context': 'https://schema.org', '@type': 'ElectronicsStore',
            'name': _st.storeName, 'url': url('homepage'),
            'logo': absolute_url(asset('images/logo-toanstore.webp')),
            'image': absolute_url(asset('images/og-image.jpg')),
            'telephone': _st.hotline, 'email': _st.email,
            'address': {'@type': 'PostalAddress', 'streetAddress': _st.address, 'addressCountry': 'VN'},
            'priceRange': '$$'
        }|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
        <script type="application/ld+json">{{ {
            '@context': 'https://schema.org', '@type': 'WebSite',
            'name': _st.storeName, 'url': url('homepage'),
            'potentialAction': {
                '@type': 'SearchAction',
                'target': {'@type': 'EntryPoint', 'urlTemplate': url('search_products') ~ '?keyword={search_term_string}'},
                'query-input': 'required name=search_term_string'
            }
        }|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('images/favicon-32.png') }}">
        <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('images/favicon-192.png') }}">
        <link rel="apple-touch-icon" href="{{ asset('images/favicon-192.png') }}">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
        <link href="{{ asset('css/techstore.css') }}" rel="stylesheet">
        <link href="{{ asset('css/storefront.css') }}" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="{% block body_class %}{% endblock %}">
    {% set _cart = app.session.get('cart') %}
    {% set st = store_settings() %}

    <div id="ts-progress"></div>
    <a class="visually-hidden-focusable gv-skip" href="#main">Bỏ qua tới nội dung</a>

    <header class="gv-header" id="siteHeader">
        <div class="gv-header__main">
            <div class="gv-container">
                <div class="gv-header__row">
                    <button class="gv-hbtn gv-hbtn--icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#catOffcanvas" aria-label="Mở danh mục">
                        <i class="bi bi-list"></i>
                    </button>

                    <a href="{{ path('homepage') }}" class="gv-header__logo" aria-label="TOÀN STORE — Trang chủ">
                        {% include 'partials/_logo.html.twig' with {tone: 'light'} %}
                    </a>

                    <div class="gv-catmenu d-none d-lg-block">
                        <button class="gv-hbtn gv-catmenu__btn" type="button" aria-expanded="false" aria-controls="catMenuPanel">
                            <i class="bi bi-grid-3x3-gap-fill"></i><span>Danh mục</span>
                        </button>
                        <div class="gv-catmenu__panel" id="catMenuPanel">
                            {% include 'partials/_mega_menu.html.twig' with {dropdown: true} %}
                        </div>
                    </div>

                    <form class="gv-search" action="{{ path('search_products') }}" method="get" role="search" data-suggest="{{ path('search_api') }}">
                        <input type="search" name="keyword" class="gv-search__input" placeholder="Bạn cần tìm gì? Laptop, VGA, màn hình..." value="{{ app.request.query.get('keyword') }}" autocomplete="off" aria-label="Tìm kiếm sản phẩm" aria-autocomplete="list" aria-controls="searchSuggest">
                        <button type="submit" class="gv-search__btn" aria-label="Tìm kiếm"><i class="bi bi-search"></i></button>
                        <div class="gv-suggest" id="searchSuggest" role="listbox" hidden></div>
                    </form>

                    <div class="gv-header__actions">
                        <a href="tel:{{ st.hotline|replace({' ': ''}) }}" class="gv-hlink d-none d-xxl-flex">
                            <i class="bi bi-headset"></i><span><small>Hotline</small><b>{{ st.hotline }}</b></span>
                        </a>
                        <a href="{{ path('shop_stores') }}" class="gv-hlink d-none d-xl-flex">
                            <i class="bi bi-geo-alt"></i><span><small>Hệ thống</small><b>Showroom</b></span>
                        </a>
                        <a href="{{ path('lookup_order') }}" class="gv-hlink d-none d-xl-flex">
                            <i class="bi bi-truck"></i><span><small>Tra cứu</small><b>Đơn hàng</b></span>
                        </a>
                        <a href="{{ path('app_wishlist') }}" class="gv-hlink gv-hlink--icon d-none d-md-flex" aria-label="Yêu thích">
                            <i class="bi bi-heart"></i>
                            <span id="wish-count" class="gv-badge-count">{{ app.session.get('wishlist')|default([])|length }}</span>
                        </a>
                        <button class="gv-hbtn gv-hbtn--cart" type="button" data-bs-toggle="offcanvas" data-bs-target="#miniCart" aria-label="Giỏ hàng">
                            <i class="bi bi-cart3"></i><span class="d-none d-sm-inline">Giỏ hàng</span>
                            <span id="cart-count" class="gv-badge-count">{{ _cart ? _cart.getTotalItems() : 0 }}</span>
                        </button>
                        {% if app.user %}
                            <div class="dropdown">
                                <button class="gv-hbtn gv-hbtn--dark dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i><span class="d-none d-md-inline line-clamp-1" style="max-width:110px">{{ app.user.userIdentifier }}</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li><a class="dropdown-item" href="{{ path('profile') }}"><i class="bi bi-person me-2"></i>Tài khoản của tôi</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_my_orders') }}"><i class="bi bi-bag me-2"></i>Đơn hàng của tôi</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_wishlist') }}"><i class="bi bi-heart me-2"></i>Sản phẩm yêu thích</a></li>
                                    {% if is_granted('ROLE_ADMIN') %}<li><a class="dropdown-item" href="{{ path('app_admin') }}"><i class="bi bi-speedometer2 me-2"></i>Trang quản trị</a></li>{% endif %}
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                                </ul>
                            </div>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="gv-hbtn gv-hbtn--dark"><i class="bi bi-person-circle"></i><span class="d-none d-md-inline">Đăng nhập</span></a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <nav class="gv-subnav d-none d-lg-block" aria-label="Tiện ích">
            <div class="gv-container">
                <ul class="gv-subnav__list">
                    <li><a href="{{ path('shop_promotions') }}" class="is-hot"><i class="bi bi-fire"></i>Khuyến mãi hot</a></li>
                    <li><a href="{{ path('shop_builder') }}"><i class="bi bi-cpu"></i>Build PC theo yêu cầu</a></li>
                    <li><a href="{{ path('page_installment') }}"><i class="bi bi-credit-card-2-front"></i>Trả góp 0%</a></li>
                    <li><a href="{{ path('lookup_warranty') }}"><i class="bi bi-shield-check"></i>Tra cứu bảo hành</a></li>
                    <li><a href="{{ path('app_news') }}"><i class="bi bi-newspaper"></i>Tin tức - Review</a></li>
                    <li><a href="{{ path('shop_brands') }}"><i class="bi bi-award"></i>Thương hiệu</a></li>
                    <li><a href="{{ path('shop_stores') }}"><i class="bi bi-shop"></i>Hệ thống showroom</a></li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="gv-catmenu__backdrop" hidden></div>

    {# ===== Categories offcanvas (mobile) ===== #}
    <div class="offcanvas offcanvas-start gv-offcanvas" tabindex="-1" id="catOffcanvas" aria-labelledby="catOffcanvasLabel">
        <div class="offcanvas-header">
            <span id="catOffcanvasLabel">{% include 'partials/_logo.html.twig' with {tone: 'dark', compact: true} %}</span>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
        </div>
        <div class="offcanvas-body p-0">
            <div class="gv-oc-title">Danh mục sản phẩm</div>
            {% for item in mega_menu() %}
                <a href="{{ path('app_productofcate', {'id': item.category.id}) }}" class="gv-oc-link"><i class="bi bi-{{ item.icon }}"></i>{{ item.label }}<i class="bi bi-chevron-right ms-auto"></i></a>
            {% else %}
                <span class="gv-oc-link text-muted">Chưa có danh mục</span>
            {% endfor %}
            <div class="gv-oc-title">Tiện ích</div>
            <a href="{{ path('shop_promotions') }}" class="gv-oc-link"><i class="bi bi-fire"></i>Khuyến mãi hot</a>
            <a href="{{ path('shop_builder') }}" class="gv-oc-link"><i class="bi bi-cpu"></i>Build PC theo yêu cầu</a>
            <a href="{{ path('shop_brands') }}" class="gv-oc-link"><i class="bi bi-award"></i>Thương hiệu</a>
            <a href="{{ path('lookup_order') }}" class="gv-oc-link"><i class="bi bi-truck"></i>Tra cứu đơn hàng</a>
            <a href="{{ path('lookup_warranty') }}" class="gv-oc-link"><i class="bi bi-shield-check"></i>Tra cứu bảo hành</a>
            <a href="{{ path('app_compare') }}" class="gv-oc-link"><i class="bi bi-arrow-left-right"></i>So sánh sản phẩm</a>
            <a href="{{ path('app_wishlist') }}" class="gv-oc-link"><i class="bi bi-heart"></i>Yêu thích</a>
            {% if app.user %}<a href="{{ path('app_my_orders') }}" class="gv-oc-link"><i class="bi bi-bag"></i>Đơn hàng của tôi</a>{% endif %}
            <a href="{{ path('app_news') }}" class="gv-oc-link"><i class="bi bi-newspaper"></i>Tin tức - Review</a>
            <a href="{{ path('shop_stores') }}" class="gv-oc-link"><i class="bi bi-shop"></i>Hệ thống showroom</a>
            <a href="{{ path('app_contact') }}" class="gv-oc-link"><i class="bi bi-headset"></i>Liên hệ</a>
        </div>
    </div>

    {# ===== Mini-cart offcanvas ===== #}
    <div class="offcanvas offcanvas-end gv-offcanvas" tabindex="-1" id="miniCart" aria-labelledby="miniCartLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="miniCartLabel"><i class="bi bi-cart3 me-2 text-danger"></i>Giỏ hàng</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            {% if _cart and _cart.getTotalItems() > 0 %}
                <div class="flex-grow-1 overflow-auto">
                    {% for item in _cart.getItems() %}
                        <div class="gv-mini-line">
                            <img src="{{ asset('uploads/sanpham/' ~ item.product.photo) }}" alt="{{ item.product.name }}">
                            <div class="flex-grow-1 min-w-0">
                                <div class="line-clamp-2 small fw-medium">{{ item.product.name }}</div>
                                <div class="small"><span class="text-muted">{{ item.quantity }} ×</span> <b class="text-danger">{{ item.product.price|vnd }}</b></div>
                            </div>
                            <form action="{{ path('app_cart_remove', {'product_id': item.product.id}) }}" method="POST">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_remove_' ~ item.product.id) }}" />
                                <button type="submit" class="btn btn-link text-muted p-0" aria-label="Xóa"><i class="bi bi-trash3"></i></button>
                            </form>
                        </div>
                    {% endfor %}
                </div>
                <div class="d-flex justify-content-between fw-bold my-3 fs-5">
                    <span>Tạm tính</span><span class="text-danger">{{ _cart.getAmount()|vnd }}</span>
                </div>
                <a href="{{ path('app_order') }}" class="btn btn-danger btn-lg-cta mb-2">Thanh toán ngay</a>
                <a href="{{ path('app_cart') }}" class="btn btn-outline-secondary">Xem giỏ hàng</a>
            {% else %}
                <div class="text-center text-muted my-auto">
                    <i class="bi bi-cart-x" style="font-size:2.6rem"></i>
                    <p class="mt-2 mb-3">Giỏ hàng của bạn đang trống.</p>
                    <a href="{{ path('feature_product') }}" class="btn btn-danger btn-sm px-4">Mua sắm ngay</a>
                </div>
            {% endif %}
        </div>
    </div>

    {# Flash messages #}
    {% set _flashes = app.flashes %}
    {% if _flashes is not empty %}
    <div class="gv-container mt-3">
        {% for type, messages in _flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : (type == 'success' ? 'success' : type) }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
    {% endif %}

    <main id="main">{% block body %}{% endblock %}</main>

    {# Trust strip above the footer #}
    <section class="gv-trust" aria-label="Cam kết của Toàn Store">
        <div class="gv-container">
            <div class="gv-trust__grid">
                <div class="gv-trust__item"><i class="bi bi-patch-check"></i><div><b>100% chính hãng</b><span>Hoá đơn VAT đầy đủ</span></div></div>
                <div class="gv-trust__item"><i class="bi bi-truck"></i><div><b>Giao nhanh 2 giờ</b><span>Miễn phí đơn từ 5 triệu</span></div></div>
                <div class="gv-trust__item"><i class="bi bi-arrow-repeat"></i><div><b>Đổi trả 7 ngày</b><span>Lỗi là đổi mới</span></div></div>
                <div class="gv-trust__item"><i class="bi bi-credit-card-2-front"></i><div><b>Trả góp 0%</b><span>Duyệt nhanh qua thẻ</span></div></div>
            </div>
        </div>
    </section>

    <footer class="gv-footer">
        <div class="gv-container">
            <div class="gv-footer__top">
                <div class="gv-footer__brand">
                    {% include 'partials/_logo.html.twig' with {tone: 'dark'} %}
                    <p>Hệ thống bán lẻ máy tính, laptop, PC gaming và linh kiện chính hãng — tư vấn tận tâm, bảo hành minh bạch.</p>
                    <div class="gv-footer__contact">
                        <a href="tel:{{ st.hotline|replace({' ': ''}) }}"><i class="bi bi-telephone"></i> {{ st.hotline }}</a>
                        <a href="mailto:{{ st.email }}"><i class="bi bi-envelope"></i> {{ st.email }}</a>
                        <span><i class="bi bi-geo-alt"></i> {{ st.address }}</span>
                    </div>
                </div>
                <div class="gv-footer__col">
                    <h6>Về Toàn Store</h6>
                    <a href="{{ path('page_about') }}">Giới thiệu</a>
                    <a href="{{ path('shop_stores') }}">Hệ thống showroom</a>
                    <a href="{{ path('page_careers') }}">Tuyển dụng</a>
                    <a href="{{ path('app_news') }}">Tin tức - Review</a>
                    <a href="{{ path('app_contact') }}">Liên hệ</a>
                </div>
                <div class="gv-footer__col">
                    <h6>Chính sách</h6>
                    <a href="{{ path('page_warranty') }}">Chính sách bảo hành</a>
                    <a href="{{ path('page_return') }}">Chính sách đổi trả</a>
                    <a href="{{ path('page_shipping') }}">Chính sách giao hàng</a>
                    <a href="{{ path('page_privacy') }}">Bảo mật thông tin</a>
                    <a href="{{ path('page_terms') }}">Điều khoản sử dụng</a>
                </div>
                <div class="gv-footer__col">
                    <h6>Hỗ trợ khách hàng</h6>
                    <a href="{{ path('page_buyguide') }}">Hướng dẫn mua hàng</a>
                    <a href="{{ path('page_payguide') }}">Hướng dẫn thanh toán</a>
                    <a href="{{ path('page_installment') }}">Hướng dẫn trả góp</a>
                    <a href="{{ path('lookup_order') }}">Tra cứu đơn hàng</a>
                    <a href="{{ path('lookup_warranty') }}">Tra cứu bảo hành</a>
                    <a href="{{ path('page_faq') }}">Câu hỏi thường gặp</a>
                </div>
                <div class="gv-footer__col">
                    <h6>Kết nối với chúng tôi</h6>
                    <div class="gv-footer__social">
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                        <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    </div>
                    <h6 class="mt-3">Thanh toán</h6>
                    <div class="gv-footer__pay"><span>VISA</span><span>Mastercard</span><span>MoMo</span><span>JCB</span><span>COD</span></div>
                </div>
            </div>
            <div class="gv-footer__bottom">
                <span>© {{ "now"|date("Y") }} TOÀN STORE. Bảo lưu mọi quyền.</span>
                <span>Giá và khuyến mãi có thể thay đổi theo thời điểm.</span>
            </div>
        </div>
    </footer>

    {# Back-to-top button (behavior in ui.js) #}
    <button id="ts-totop" type="button" aria-label="Lên đầu trang"><i class="bi bi-arrow-up"></i></button>
    {# Floating hotline button with pulse ring #}
    <a href="tel:{{ st.hotline|replace({' ': ''}) }}" id="ts-hotline" aria-label="Gọi hotline {{ st.hotline }}" title="Hotline {{ st.hotline }}"><i class="bi bi-telephone-fill"></i></a>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>

    {# Floating compare bar #}
    {% set _compare = app.session.get('compare')|default([]) %}
    <div id="compare-bar" class="position-fixed bottom-0 start-50 translate-middle-x mb-3 bg-dark text-white rounded-pill px-3 py-2 shadow align-items-center gap-3 {{ _compare|length == 0 ? 'd-none' : 'd-flex' }}" style="z-index:1070;">
        <span><i class="bi bi-arrow-left-right"></i> So sánh (<span id="compare-count">{{ _compare|length }}</span>)</span>
        <a href="{{ path('app_compare') }}" class="btn btn-sm btn-danger">Xem so sánh</a>
        <a href="{{ path('app_compare_clear') }}" class="text-white-50" aria-label="Xóa"><i class="bi bi-x-lg"></i></a>
    </div>

    {# Toast for AJAX add-to-cart #}
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div id="cart-toast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="cart-toast-body">Đã thêm vào giỏ.</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Đóng"></button>
            </div>
        </div>
    </div>
    <script>
    document.addEventListener('submit', function (e) {
        var form = e.target.closest('.add-to-cart-form');
        if (!form) return;
        e.preventDefault();
        fetch(form.action, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: new FormData(form) })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
            .then(function (res) {
                var toastEl = document.getElementById('cart-toast');
                var body = document.getElementById('cart-toast-body');
                if (res.ok && res.d.ok) {
                    var badge = document.getElementById('cart-count');
                    if (badge) badge.textContent = res.d.count;
                    toastEl.classList.remove('bg-danger'); toastEl.classList.add('bg-success');
                } else {
                    toastEl.classList.remove('bg-success'); toastEl.classList.add('bg-danger');
                }
                body.textContent = res.d.message || 'Có lỗi xảy ra.';
                bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 2500 }).show();
            })
            .catch(function () { window.location.href = form.action; });
    });
    // Wishlist toggle (AJAX)
    document.addEventListener('submit', function (e) {
        var form = e.target.closest('.wishlist-form');
        if (!form) return;
        e.preventDefault();
        fetch(form.action, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d.ok) return;
                var btn = form.querySelector('.gv-wish-btn');
                var icon = form.querySelector('i');
                if (btn) btn.classList.toggle('active', d.active);
                if (icon) { icon.className = 'bi ' + (d.active ? 'bi-heart-fill' : 'bi-heart'); }
                var wc = document.getElementById('wish-count'); if (wc) wc.textContent = d.count;
                var toastEl = document.getElementById('cart-toast');
                document.getElementById('cart-toast-body').textContent = d.message;
                toastEl.classList.remove('bg-danger'); toastEl.classList.add('bg-success');
                bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 2000 }).show();
            })
            .catch(function () { window.location.href = form.action; });
    });
    // Compare toggle (AJAX)
    document.addEventListener('submit', function (e) {
        var form = e.target.closest('.compare-form');
        if (!form) return;
        e.preventDefault();
        fetch(form.action, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                var toastEl = document.getElementById('cart-toast');
                document.getElementById('cart-toast-body').textContent = d.message;
                toastEl.classList.remove('bg-success', 'bg-danger'); toastEl.classList.add(d.ok ? 'bg-success' : 'bg-danger');
                bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 2000 }).show();
                if (!d.ok) return;
                var btn = form.querySelector('.gv-wish-btn'); if (btn) btn.classList.toggle('active', d.active);
                var cc = document.getElementById('compare-count'); if (cc) cc.textContent = d.count;
                var bar = document.getElementById('compare-bar'); if (bar) { bar.classList.toggle('d-none', d.count == 0); bar.classList.toggle('d-flex', d.count > 0); }
            })
            .catch(function () { window.location.href = form.action; });
    });
    </script>
    <script src="{{ asset('js/ui.js') }}"></script>
    <script src="{{ asset('js/storefront.js') }}"></script>
    {% block javascripts %}{% endblock %}
    </body>
</html>
