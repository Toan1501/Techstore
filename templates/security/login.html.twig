{% extends 'base.html.twig' %}

{% block title %}Đăng nhập — TECHSTORE{% endblock %}

{% block body %}
<div class="container py-5" style="max-width:440px">
    <div class="gv-section">
        <h1 class="h4 text-center mb-4">Đăng nhập</h1>

        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}
        {% if app.user %}
            <div class="alert alert-info">Bạn đang đăng nhập với tên {{ app.user.userIdentifier }}. <a href="{{ path('app_logout') }}">Đăng xuất</a></div>
        {% endif %}

        <form method="post">
            <div class="mb-3">
                <label for="inputUsername" class="form-label">Tên đăng nhập</label>
                <input type="text" value="{{ last_username }}" name="username" id="inputUsername" class="form-control" autocomplete="username" required autofocus>
            </div>
            <div class="mb-3">
                <label for="inputPassword" class="form-label">Mật khẩu</label>
                <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <div class="form-check mb-3">
                <input type="checkbox" name="_remember_me" id="remember" class="form-check-input">
                <label class="form-check-label" for="remember">Ghi nhớ đăng nhập</label>
            </div>
            <button class="btn btn-danger w-100" type="submit">Đăng nhập</button>
        </form>

        <p class="text-center mt-3 mb-0">Chưa có tài khoản? <a href="{{ path('app_register') }}">Đăng ký ngay</a></p>
    </div>
</div>
{% endblock %}
