{% extends 'base.html.twig' %}

{% block title %}Đơn hàng #{{ order.id }} — TOÀN STORE{% endblock %}

{% block body %}
<div class="container my-4" style="max-width:900px">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_my_orders') }}">Đơn hàng của tôi</a></li>
            <li class="breadcrumb-item active" aria-current="page">Đơn #{{ order.id }}</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h1 class="h4 mb-0">Đơn hàng #{{ order.id }}</h1>
        <span class="badge bg-{{ order.statusColor }} {{ order.statusColor in ['warning','light','info'] ? 'text-dark' : '' }} fs-6">{{ order.statusLabel }}</span>
    </div>

    <div class="gv-section">
        {% include 'partials/_order_timeline.html.twig' with {status: order.status} %}
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="gv-section">
                <div class="gv-section__head"><h2 style="font-size:1rem">Sản phẩm</h2></div>
                <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <tbody>
                        {% for item in order.items %}
                        <tr>
                            <td style="width:60px"><img src="{{ asset('uploads/sanpham/' ~ (item.product ? item.product.photo : '')) }}" height="46" alt=""></td>
                            <td>{{ item.product ? item.product.name : '(đã xóa)' }}<div class="text-muted small">SL: {{ item.quantity }}</div></td>
                            <td class="text-end">{{ item.total|vnd }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr><td colspan="2" class="text-end">Tạm tính</td><td class="text-end">{{ order.subtotal|vnd }}</td></tr>
                        {% if order.discount > 0 %}<tr class="text-success"><td colspan="2" class="text-end">Giảm giá{{ order.couponCode ? ' (' ~ order.couponCode ~ ')' : '' }}</td><td class="text-end">-{{ order.discount|vnd }}</td></tr>{% endif %}
                        <tr><td colspan="2" class="text-end">Phí vận chuyển</td><td class="text-end">{{ order.shippingFee == 0 ? 'Miễn phí' : order.shippingFee|vnd }}</td></tr>
                        <tr class="fw-bold"><td colspan="2" class="text-end">Tổng cộng</td><td class="text-end text-danger">{{ order.totalPrice|vnd }}</td></tr>
                    </tfoot>
                </table>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="gv-section">
                <div class="gv-section__head"><h2 style="font-size:1rem">Giao hàng & thanh toán</h2></div>
                <p class="mb-1"><strong>{{ order.customerName }}</strong> — {{ order.customerPhone }}</p>
                <p class="mb-1">{{ order.customerEmail }}</p>
                <p class="mb-1">{{ order.fullAddress }}</p>
                <p class="mb-1">Thanh toán: {{ order.paymentMethodLabel }}</p>
                <p class="mb-0 text-muted small">Ngày đặt: {{ order.createdAt ? order.createdAt|date('d/m/Y H:i') : '' }}</p>

                {% if order.status == 'pending' %}
                <hr>
                <form method="post" action="{{ path('app_order_cancel', {'id': order.id}) }}" onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn hàng này?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_order_' ~ order.id) }}">
                    <button type="submit" class="btn btn-outline-danger w-100"><i class="bi bi-x-circle"></i> Hủy đơn hàng</button>
                </form>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="mt-3"><a href="{{ path('app_my_orders') }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Danh sách đơn</a></div>
</div>
{% endblock %}
