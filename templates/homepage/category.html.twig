{% extends 'base.html.twig' %}

{% block title %}Danh mục sản phẩm — TECHSTORE{% endblock %}

{% block body %}
<div class="container-fluid px-3 px-xl-5 py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Danh mục</li>
        </ol>
    </nav>

    <div class="gv-section">
        <div class="gv-section__head"><h2>Danh mục sản phẩm</h2></div>
        <div class="gv-cats">
            {% for c in category %}
                <a href="{{ path('app_productofcate', {'id': c.id}) }}" class="gv-cat-tile">
                    <img src="{{ asset('uploads/sanpham/' ~ c.getPhoto()) }}" alt="{{ c.name }}">
                    <span>{{ c.name }}</span>
                </a>
            {% else %}
                <p class="text-muted">Chưa có danh mục.</p>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
