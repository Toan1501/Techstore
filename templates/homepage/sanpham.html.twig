{% extends 'base.html.twig' %}

{% block title %}{{ heading|default('Sản phẩm') }} — TOÀN STORE{% endblock %}
{% block meta_description %}{{ meta_description is defined ? meta_description : (intro is defined and intro ? intro : parent()) }}{% endblock %}

{#
  Product listing (category / search / brand / landing / all products).
  Optional: facets {brands, ranges}, filters (ListingFilters), sort, keyword, intro, category
#}

{% macro url(route, rparams, query, changes) %}{{ path(route, rparams|merge(query|merge(changes)|filter((v, k) => v is not null and v is not same as('') and k != 'page'))) }}{% endmacro %}

{% block body %}
{% import _self as u %}
{% set route = app.request.attributes.get('_route') %}
{% set rparams = app.request.attributes.get('_route_params')|default({}) %}
{% set query = app.request.query.all %}
{% set f = filters|default({'brand': [], 'min_price': null, 'max_price': null, 'in_stock': false, 'min_rating': null}) %}
{% set curSort = sort|default('newest') %}
{% set hasFacets = facets is defined %}
<div class="gv-container py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb gv-crumb">
            <li class="breadcrumb-item"><a href="{{ path('homepage') }}"><i class="bi bi-house-door"></i> Trang chủ</a></li>
            {% if category is defined and category %}
                <li class="breadcrumb-item"><a href="{{ path('feature_product') }}">Sản phẩm</a></li>
            {% endif %}
            <li class="breadcrumb-item active" aria-current="page">{{ heading|default('Sản phẩm') }}</li>
        </ol>
    </nav>

    <div class="lst-hero">
        <div>
            <h1 class="lst-hero__title">{{ heading|default('Sản phẩm') }}</h1>
            {% if intro is defined and intro %}<p class="lst-hero__intro">{{ intro }}</p>{% endif %}
        </div>
        {% if hasFacets and facets.brands is not empty %}
            <div class="lst-hero__brands">
                {% for b, n in facets.brands|slice(0, 8, true) %}
                    {% set on = b in f.brand %}
                    <a href="{{ u.url(route, rparams, query, {'brand': on ? null : [b]}) }}" class="lst-brand{{ on ? ' is-on' : '' }}">{{ b }}</a>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="lst">
        {# ===== Sidebar filters (inline ≥lg, offcanvas below) ===== #}
        {% if hasFacets %}
        <aside class="lst__side offcanvas-lg offcanvas-start" tabindex="-1" id="filterPanel" aria-labelledby="filterTitle">
            <div class="offcanvas-header d-lg-none">
                <h5 class="offcanvas-title" id="filterTitle"><i class="bi bi-funnel"></i> Bộ lọc</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#filterPanel" aria-label="Đóng"></button>
            </div>
            <form method="get" class="flt" data-autosubmit>
                {% if keyword is defined and keyword %}<input type="hidden" name="keyword" value="{{ keyword }}">{% endif %}
                <input type="hidden" name="sort" value="{{ curSort }}">
                <div class="flt__head d-none d-lg-flex"><i class="bi bi-funnel"></i> Bộ lọc tìm kiếm</div>

                <fieldset class="flt__group">
                    <legend>Khoảng giá</legend>
                    {% set curRange = (f.min_price ?? '') ~ '-' ~ (f.max_price ?? '') %}
                    <label class="flt__opt"><input type="radio" name="price" value="" {{ curRange == '-' ? 'checked' }}><span>Tất cả</span></label>
                    {% for r in facets.ranges %}
                        {% set val = (r.min ?? '') ~ '-' ~ (r.max ?? '') %}
                        <label class="flt__opt"><input type="radio" name="price" value="{{ val }}" {{ curRange == val ? 'checked' }}><span>{{ r.label }}</span></label>
                    {% endfor %}
                    <div class="flt__range">
                        <input type="number" min="0" step="100000" name="min_price" value="{{ f.min_price }}" placeholder="Từ" class="form-control form-control-sm" aria-label="Giá từ" data-manual-price>
                        <span>–</span>
                        <input type="number" min="0" step="100000" name="max_price" value="{{ f.max_price }}" placeholder="Đến" class="form-control form-control-sm" aria-label="Giá đến" data-manual-price>
                    </div>
                </fieldset>

                {% if facets.brands is not empty %}
                <fieldset class="flt__group">
                    <legend>Thương hiệu</legend>
                    <div class="flt__scroll">
                        {% for b, n in facets.brands %}
                            <label class="flt__opt"><input type="checkbox" name="brand[]" value="{{ b }}" {{ b in f.brand ? 'checked' }}><span>{{ b }}</span><em>{{ n }}</em></label>
                        {% endfor %}
                    </div>
                </fieldset>
                {% endif %}

                <fieldset class="flt__group">
                    <legend>Tình trạng</legend>
                    <label class="flt__opt"><input type="checkbox" name="in_stock" value="1" {{ f.in_stock ? 'checked' }}><span>Chỉ hiện hàng có sẵn</span></label>
                </fieldset>

                <fieldset class="flt__group">
                    <legend>Đánh giá</legend>
                    <label class="flt__opt"><input type="radio" name="min_rating" value="" {{ not f.min_rating ? 'checked' }}><span>Tất cả</span></label>
                    {% for s in [4, 3] %}
                        <label class="flt__opt"><input type="radio" name="min_rating" value="{{ s }}" {{ f.min_rating == s ? 'checked' }}><span class="flt__stars">{% for i in 1..5 %}<i class="bi bi-star{{ i <= s ? '-fill' : '' }}"></i>{% endfor %} trở lên</span></label>
                    {% endfor %}
                </fieldset>

                <div class="flt__actions">
                    <button type="submit" class="btn btn-danger w-100">Áp dụng</button>
                    <a href="{{ path(route, rparams|merge(keyword is defined and keyword ? {'keyword': keyword} : {})) }}" class="btn btn-light w-100">Xóa bộ lọc</a>
                </div>
            </form>
        </aside>
        {% endif %}

        {# ===== Results ===== #}
        <section class="lst__main" aria-label="Kết quả">
            <div class="lst-bar">
                <div class="lst-bar__count">
                    {% if hasFacets %}<button class="btn btn-outline-secondary btn-sm d-lg-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterPanel"><i class="bi bi-funnel"></i> Lọc</button>{% endif %}
                    Tìm thấy <b>{{ data.getTotalItemCount is defined ? data.getTotalItemCount : data|length }}</b> sản phẩm
                </div>
                <div class="lst-sort" role="tablist" aria-label="Sắp xếp">
                    <span class="d-none d-md-inline text-muted">Sắp xếp:</span>
                    {% for key, label in {'newest': 'Mới nhất', 'discount': 'Giảm nhiều', 'price_asc': 'Giá tăng dần', 'price_desc': 'Giá giảm dần', 'name': 'Tên A-Z'} %}
                        <a href="{{ u.url(route, rparams, query, {'sort': key}) }}" class="lst-sort__tab{{ curSort == key ? ' is-on' : '' }}" role="tab" aria-selected="{{ curSort == key ? 'true' : 'false' }}">{{ label }}</a>
                    {% endfor %}
                </div>
            </div>

            {# Active filter chips #}
            {% set chipsOn = f.brand is not empty or f.min_price is not null or f.max_price is not null or f.in_stock or f.min_rating %}
            {% if chipsOn %}
                <div class="lst-active">
                    {% for b in f.brand %}
                        {% set rest = f.brand|filter(x => x != b)|reduce((c, x) => c|merge([x]), []) %}
                        <a href="{{ u.url(route, rparams, query, {'brand': rest is empty ? null : rest}) }}" class="lst-chip">{{ b }} <i class="bi bi-x"></i></a>
                    {% endfor %}
                    {% if f.min_price is not null or f.max_price is not null %}
                        <a href="{{ u.url(route, rparams, query, {'price': null, 'min_price': null, 'max_price': null}) }}" class="lst-chip">
                            {{ f.min_price is not null ? (f.min_price|vnd) : '0₫' }} – {{ f.max_price is not null ? (f.max_price|vnd) : 'trở lên' }} <i class="bi bi-x"></i>
                        </a>
                    {% endif %}
                    {% if f.in_stock %}<a href="{{ u.url(route, rparams, query, {'in_stock': null}) }}" class="lst-chip">Còn hàng <i class="bi bi-x"></i></a>{% endif %}
                    {% if f.min_rating %}<a href="{{ u.url(route, rparams, query, {'min_rating': null}) }}" class="lst-chip">Từ {{ f.min_rating }} sao <i class="bi bi-x"></i></a>{% endif %}
                    <a href="{{ path(route, rparams|merge(keyword is defined and keyword ? {'keyword': keyword} : {})) }}" class="lst-chip lst-chip--clear">Xóa tất cả</a>
                </div>
            {% endif %}

            {% if data|length %}
                <div class="pgrid{{ hasFacets ? ' pgrid--4' : ' pgrid--5' }}">
                    {% for sp in data %}
                        {% include 'partials/_product_card.html.twig' with {sp: sp, ratings: ratings|default({})} %}
                    {% endfor %}
                </div>
            {% else %}
                <div class="lst-empty">
                    <i class="bi bi-search"></i>
                    <p>Không tìm thấy sản phẩm phù hợp.</p>
                    <a href="{{ path(route, rparams) }}" class="btn btn-outline-danger btn-sm">Bỏ bộ lọc</a>
                </div>
            {% endif %}

            {% if data.haveToPaginate is defined and data.haveToPaginate %}
                <div class="d-flex justify-content-center mt-4">{{ knp_pagination_render(data) }}</div>
            {% endif %}
        </section>
    </div>
</div>
{% endblock %}
