{% extends 'base.html.twig' %}

{% block title %}{{ heading|default('Sản phẩm') }} — TOÀN STORE{% endblock %}

{% block body %}
<div class="container-fluid px-3 px-xl-5 py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ heading|default('Sản phẩm') }}</li>
        </ol>
    </nav>

    <div class="gv-section">
        <div class="gv-listing-bar">
            <div>
                <h2 class="gv-listing-title">{{ heading|default('Sản phẩm') }}</h2>
                {% if data.getTotalItemCount is defined %}
                    <span class="text-muted small">{{ data.getTotalItemCount }} sản phẩm</span>
                {% endif %}
            </div>
            {% if sort is defined %}
            <form method="get" class="d-flex align-items-center gap-2">
                {% if keyword is defined %}<input type="hidden" name="keyword" value="{{ keyword }}">{% endif %}
                <label for="sortSel" class="form-label small mb-0 text-nowrap d-none d-sm-block">Sắp xếp:</label>
                <select name="sort" id="sortSel" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
                    <option value="newest" {{ sort == 'newest' ? 'selected' }}>Mới nhất</option>
                    <option value="price_asc" {{ sort == 'price_asc' ? 'selected' }}>Giá thấp → cao</option>
                    <option value="price_desc" {{ sort == 'price_desc' ? 'selected' }}>Giá cao → thấp</option>
                    <option value="name" {{ sort == 'name' ? 'selected' }}>Tên A–Z</option>
                </select>
            </form>
            {% endif %}
        </div>

        <div class="row g-3">
            {% for sp in data %}
                <div class="col-6 col-md-4 col-lg-3">
                    {% include 'partials/_product_card.html.twig' with {sp: sp, ratings: ratings|default({})} %}
                </div>
            {% else %}
                <div class="col-12 text-center text-muted py-5">
                    <i class="bi bi-search" style="font-size:2.4rem"></i>
                    <p class="mt-3 mb-2">Không tìm thấy sản phẩm nào.</p>
                    <a href="{{ path('homepage') }}" class="btn btn-outline-danger btn-sm">Về trang chủ</a>
                </div>
            {% endfor %}
        </div>
        {% if data.haveToPaginate is defined and data.haveToPaginate %}
            <div class="d-flex justify-content-center mt-4">{{ knp_pagination_render(data) }}</div>
        {% endif %}
    </div>
</div>
{% endblock %}
