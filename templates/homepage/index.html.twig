{% extends 'base.html.twig' %}

{% block title %}TECHSTORE — Máy tính, Laptop & Linh kiện chính hãng{% endblock %}

{% block body %}
<div class="container-fluid px-3 px-xl-5 py-3">

    {# ===== Hero + side banners ===== #}
    <div class="row g-3 mb-3">
        <div class="col-lg-9">
            {% set slides = banners is not empty ? banners : null %}
            <div id="heroCarousel" class="carousel slide rounded overflow-hidden" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    {% if slides %}
                        {% for b in slides %}<button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="{{ loop.index0 }}" class="{{ loop.first ? 'active' : '' }}"></button>{% endfor %}
                    {% else %}
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
                    {% endif %}
                </div>
                <div class="carousel-inner" style="aspect-ratio: 3/1; background:#fff">
                    {% if slides %}
                        {% for b in slides %}
                            <div class="carousel-item {{ loop.first ? 'active' : '' }} h-100">
                                {% if b.link %}<a href="{{ b.link }}">{% endif %}
                                <img src="{{ asset(b.image) }}" class="w-100 h-100" style="object-fit:cover" alt="{{ b.title }}">
                                {% if b.link %}</a>{% endif %}
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="carousel-item active h-100"><img src="{{ asset('images/carousel-1.webp') }}" class="w-100 h-100" style="object-fit:cover" alt="Khuyến mãi"></div>
                    {% endif %}
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
                <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
            </div>
        </div>
        <div class="col-lg-3 d-none d-lg-flex flex-column gap-3">
            <img src="{{ asset('images/offer-4.png') }}" class="w-100 rounded" style="height:calc(50% - 0.5rem);object-fit:cover" alt="Ưu đãi">
            <img src="{{ asset('images/offer-5.png') }}" class="w-100 rounded" style="height:calc(50% - 0.5rem);object-fit:cover" alt="Ưu đãi">
        </div>
    </div>

    {# ===== Benefits strip ===== #}
    <div class="gv-benefits">
        <div class="gv-benefit"><i class="bi bi-truck"></i><div><strong>Miễn phí vận chuyển</strong><small>Đơn từ 5 triệu</small></div></div>
        <div class="gv-benefit"><i class="bi bi-shield-check"></i><div><strong>Bảo hành chính hãng</strong><small>1 đổi 1 trong 7 ngày</small></div></div>
        <div class="gv-benefit"><i class="bi bi-credit-card"></i><div><strong>Trả góp 0%</strong><small>Qua thẻ tín dụng</small></div></div>
        <div class="gv-benefit"><i class="bi bi-headset"></i><div><strong>Hỗ trợ 24/7</strong><small>Hotline 1900 5301</small></div></div>
    </div>

    {# ===== Category quick tiles ===== #}
    <div class="gv-cats mb-4">
        {% for c in category %}
            <a href="{{ path('app_productofcate', {'id': c.id}) }}" class="gv-cat-tile">
                <img src="{{ asset('uploads/sanpham/' ~ c.getPhoto()) }}" alt="{{ c.name }}">
                <span>{{ c.name }}</span>
            </a>
        {% endfor %}
    </div>

    {# ===== Flash sale ===== #}
    {% if deals is not empty %}
    <div class="gv-flashsale">
        <div class="gv-flashsale__head">
            <div class="gv-flashsale__title"><i class="bi bi-lightning-charge-fill"></i> FLASH SALE</div>
            <div class="gv-countdown">
                <span class="text-white me-1 fw-normal">Kết thúc sau</span>
                <span id="cd-h">00</span>:<span id="cd-m">00</span>:<span id="cd-s">00</span>
            </div>
        </div>
        <div class="row g-3">
            {% for sp in deals %}
                <div class="col-6 col-md-4 col-lg-2">
                    {% include 'partials/_product_card.html.twig' with {sp: sp, ratings: deals_ratings} %}
                </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# ===== All products + filters ===== #}
    <div class="gv-section">
        <div class="gv-section__head flex-wrap gap-2">
            <h2>Sản phẩm nổi bật</h2>
            <button class="btn btn-outline-danger btn-sm d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#filterBar"><i class="bi bi-funnel"></i> Bộ lọc</button>
        </div>

        <form method="get" id="filterBar" class="collapse d-lg-block bg-light border rounded-3 p-3 mb-3">
            <div class="row g-2 align-items-end">
                <div class="col-6 col-lg-2">
                    <label class="form-label small mb-1" for="f-cat">Danh mục</label>
                    <select name="category" id="f-cat" class="form-select form-select-sm">
                        <option value="">Tất cả</option>
                        {% for c in category %}<option value="{{ c.id }}" {{ filters.category == c.id ? 'selected' : '' }}>{{ c.name }}</option>{% endfor %}
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label small mb-1" for="f-brand">Thương hiệu</label>
                    <select name="brand" id="f-brand" class="form-select form-select-sm">
                        <option value="">Tất cả</option>
                        {% for b in brands %}<option value="{{ b }}" {{ filters.brand == b ? 'selected' : '' }}>{{ b }}</option>{% endfor %}
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label small mb-1" for="f-rating">Đánh giá</label>
                    <select name="min_rating" id="f-rating" class="form-select form-select-sm">
                        <option value="">Tất cả</option>
                        <option value="4" {{ filters.min_rating == '4' ? 'selected' : '' }}>Từ 4 sao</option>
                        <option value="3" {{ filters.min_rating == '3' ? 'selected' : '' }}>Từ 3 sao</option>
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label small mb-1" for="f-min">Giá từ</label>
                    <input type="number" min="0" name="min_price" id="f-min" value="{{ filters.min_price }}" class="form-control form-control-sm" placeholder="{{ price_bounds.min|round }}">
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label small mb-1" for="f-max">Đến</label>
                    <input type="number" min="0" name="max_price" id="f-max" value="{{ filters.max_price }}" class="form-control form-control-sm" placeholder="{{ price_bounds.max|round }}">
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label small mb-1" for="f-sort">Sắp xếp</label>
                    <select name="sort" id="f-sort" class="form-select form-select-sm">
                        <option value="newest" {{ sort == 'newest' ? 'selected' : '' }}>Mới nhất</option>
                        <option value="price_asc" {{ sort == 'price_asc' ? 'selected' : '' }}>Giá tăng dần</option>
                        <option value="price_desc" {{ sort == 'price_desc' ? 'selected' : '' }}>Giá giảm dần</option>
                        <option value="name" {{ sort == 'name' ? 'selected' : '' }}>Tên A–Z</option>
                    </select>
                </div>
                <div class="col-6 col-lg-2 pb-1">
                    <div class="form-check">
                        <input type="checkbox" value="1" name="in_stock" id="f-stock" class="form-check-input" {{ filters.in_stock ? 'checked' : '' }}>
                        <label class="form-check-label small" for="f-stock">Còn hàng</label>
                    </div>
                </div>
                <div class="col-6 col-lg-1 d-grid">
                    <button type="submit" class="btn btn-danger btn-sm">Lọc</button>
                </div>
            </div>
            <div class="mt-2"><a href="{{ path('homepage') }}" class="small text-muted"><i class="bi bi-arrow-counterclockwise"></i> Đặt lại</a></div>
        </form>

        <div class="row g-3">
            {% for sp in data %}
                <div class="col-6 col-md-4 col-lg-3">
                    {% include 'partials/_product_card.html.twig' with {sp: sp, ratings: ratings} %}
                </div>
            {% else %}
                <div class="col-12 text-center text-muted py-5"><i class="bi bi-inboxes" style="font-size:2rem"></i><p class="mt-2 mb-0">Không có sản phẩm.</p></div>
            {% endfor %}
        </div>

        {% if data.haveToPaginate is defined and data.haveToPaginate %}
            <div class="d-flex justify-content-center mt-4">{{ knp_pagination_render(data) }}</div>
        {% endif %}
    </div>

    {# ===== Product sections by category ===== #}
    {% for section in sections %}
    <div class="gv-section">
        <div class="gv-section__head">
            <h2>{{ section.category.name }}</h2>
            <a href="{{ path('app_productofcate', {'id': section.category.id}) }}">Xem tất cả <i class="bi bi-chevron-right"></i></a>
        </div>
        <div class="row g-3">
            {% for sp in section.products %}
                <div class="col-6 col-md-4 col-lg-2">
                    {% include 'partials/_product_card.html.twig' with {sp: sp, ratings: section_ratings} %}
                </div>
            {% endfor %}
        </div>
    </div>
    {% endfor %}

    {# ===== Brands ===== #}
    <div class="gv-section">
        <div class="gv-section__head"><h2>Thương hiệu</h2></div>
        <div class="gv-brands">
            {% for b in ['ASUS','MSI','ACER','LOGITECH','CORSAIR','GIGABYTE'] %}
                <a href="{{ path('search_products', {'keyword': b}) }}" class="gv-brand">{{ b }}</a>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var end = new Date(); end.setHours(23, 59, 59, 999);
    function tick() {
        var diff = Math.max(0, Math.floor((end - new Date()) / 1000));
        var h = String(Math.floor(diff / 3600)).padStart(2, '0');
        var m = String(Math.floor((diff % 3600) / 60)).padStart(2, '0');
        var s = String(diff % 60).padStart(2, '0');
        var eh = document.getElementById('cd-h'); if (!eh) return;
        eh.textContent = h; document.getElementById('cd-m').textContent = m; document.getElementById('cd-s').textContent = s;
    }
    tick(); setInterval(tick, 1000);
})();
</script>
{% endblock %}
