{% extends 'base.html.twig' %}

{% block title %}Sản phẩm yêu thích — TOÀN STORE{% endblock %}

{% block body %}
<div class="container-fluid px-3 px-xl-5 py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Yêu thích</li>
        </ol>
    </nav>

    <div class="gv-section">
        <div class="gv-section__head"><h2>Sản phẩm yêu thích{% if products is not empty %} ({{ products|length }}){% endif %}</h2></div>
        <div class="row g-3">
            {% for sp in products %}
                <div class="col-6 col-md-4 col-lg-3">
                    {% include 'partials/_product_card.html.twig' with {sp: sp, ratings: {}} %}
                </div>
            {% else %}
                <div class="col-12 text-center text-muted py-5">
                    <i class="bi bi-heart" style="font-size:2.5rem"></i>
                    <p class="mt-2 mb-3">Bạn chưa có sản phẩm yêu thích nào.</p>
                    <a href="{{ path('homepage') }}" class="btn btn-danger">Khám phá sản phẩm</a>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
