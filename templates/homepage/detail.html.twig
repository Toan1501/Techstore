{% extends 'base.html.twig' %}

{% block title %}{{ data.getName() }} — TOÀN STORE{% endblock %}
{% block meta_description %}{{ data.getName() }}{% if data.brand %} chính hãng {{ data.brand }}{% endif %} — giá {{ data.getPrice()|vnd }}, bảo hành {{ data.warranty ?? '12 tháng' }}. Mua ngay tại TOÀN STORE.{% endblock %}

{% block og_image %}{{ absolute_url(asset('uploads/sanpham/' ~ data.getPhoto())) }}{% endblock %}

{% block body %}
<div class="container-fluid px-3 px-xl-5 py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Trang chủ</a></li>
            {% if data.getCate() %}<li class="breadcrumb-item"><a href="{{ path('app_productofcate', {'id': data.getCate().id}) }}">{{ data.getCate().name }}</a></li>{% endif %}
            <li class="breadcrumb-item active line-clamp-1" aria-current="page">{{ data.getName() }}</li>
        </ol>
    </nav>

    {% set ld = {
        '@context': 'https://schema.org', '@type': 'Product',
        'name': data.getName(),
        'image': absolute_url(asset('uploads/sanpham/' ~ data.getPhoto())),
        'description': data.getDescription() ?: data.getName(),
        'sku': data.sku ?: '', 'brand': {'@type': 'Brand', 'name': data.brand ?: 'TOÀN STORE'},
        'offers': {'@type': 'Offer', 'priceCurrency': 'VND', 'price': data.getPrice(),
            'availability': data.isInStock() ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
            'url': app.request.uri}
    } %}
    {% if rating.count > 0 %}{% set ld = ld|merge({'aggregateRating': {'@type': 'AggregateRating', 'ratingValue': rating.average, 'reviewCount': rating.count}}) %}{% endif %}
    <script type="application/ld+json">{{ ld|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG'))|raw }}</script>
    {% set crumbs = [{'@type': 'ListItem', 'position': 1, 'name': 'Trang chủ', 'item': url('homepage')}] %}
    {% if data.getCate() %}{% set crumbs = crumbs|merge([{'@type': 'ListItem', 'position': 2, 'name': data.getCate().name, 'item': url('app_productofcate', {'id': data.getCate().id})}]) %}{% endif %}
    {% set crumbs = crumbs|merge([{'@type': 'ListItem', 'position': crumbs|length + 1, 'name': data.getName(), 'item': url('app_product', {'slug': data.slug, 'id': data.id})}]) %}
    <script type="application/ld+json">{{ {'@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': crumbs}|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG'))|raw }}</script>

    {% set inWish = data.id in (app.session.get('wishlist')|default([])) %}
    <div class="gv-section">
        <div class="row g-4">
            {# Gallery #}
            <div class="col-md-5">
                <div class="gv-gallery__main">
                    {% if data.hasDiscount() %}<span class="gv-gallery__badge">-{{ data.getDiscountPercent() }}%</span>{% endif %}
                    <img id="mainImg" src="{{ asset('uploads/sanpham/' ~ data.getPhoto()) }}" alt="{{ data.getName() }}">
                    <span class="gv-gallery__zoom"><i class="bi bi-zoom-in"></i></span>
                </div>
                {% set photos = data.getAllPhotos() %}
                {% if photos|length > 1 %}
                <div class="gv-gallery__thumbs">
                    {% for p in photos %}
                        <img src="{{ asset('uploads/sanpham/' ~ p) }}" alt="thumbnail" class="thumb-img {{ loop.first ? 'active' : '' }}" data-full="{{ asset('uploads/sanpham/' ~ p) }}">
                    {% endfor %}
                </div>
                {% endif %}
            </div>

            {# Info + buy #}
            <div class="col-md-7">
                <h1 class="gv-pd-title">{{ data.getName() }}</h1>
                <div class="d-flex align-items-center gap-3 mb-3 small flex-wrap">
                    <span>{% include 'partials/_rating_stars.html.twig' with {avg: rating.average ?? 0, count: rating.count} %}</span>
                    {% if data.brand %}<span class="text-muted">Thương hiệu: <strong>{{ data.brand }}</strong></span>{% endif %}
                    {% if data.sku %}<span class="text-muted">SKU: {{ data.sku }}</span>{% endif %}
                </div>

                <div class="gv-pd-price">
                    <div class="d-flex align-items-baseline gap-2 flex-wrap">
                        <span class="gv-pd-price__now">{{ data.getPrice()|vnd }}</span>
                        {% if data.hasDiscount() %}
                            <span class="gv-pd-price__old">{{ data.getPriceOld()|vnd }}</span>
                            <span class="gv-pd-price__off">-{{ data.getDiscountPercent() }}%</span>
                        {% endif %}
                    </div>
                    {% if data.hasDiscount() %}<div class="gv-pd-save"><i class="bi bi-piggy-bank"></i> Tiết kiệm {{ (data.getPriceOld() - data.getPrice())|vnd }}</div>{% endif %}
                </div>

                <div class="gv-pd-chips">
                    <span><i class="bi bi-patch-check-fill"></i> Chính hãng</span>
                    <span><i class="bi bi-shield-check"></i> BH {{ data.warranty ?: '12 tháng' }}</span>
                    <span><i class="bi bi-truck"></i> Giao nhanh</span>
                    <span><i class="bi bi-arrow-repeat"></i> Đổi trả 7 ngày</span>
                </div>

                <div class="mb-3">
                    {% if data.isInStock() %}
                        <span class="badge bg-success">Còn hàng ({{ data.stock }})</span>
                    {% else %}
                        <span class="badge bg-secondary">Tạm hết hàng</span>
                    {% endif %}
                </div>

                <div class="gv-pd-promo">
                    <div class="gv-pd-promo__head"><i class="bi bi-gift-fill"></i> Ưu đãi thêm</div>
                    <ul>
                        <li><i class="bi bi-check2-circle"></i> Tặng phiếu mua hàng 200.000₫ cho đơn từ 10 triệu.</li>
                        <li><i class="bi bi-check2-circle"></i> Hỗ trợ trả góp 0% qua thẻ tín dụng.</li>
                        <li><i class="bi bi-check2-circle"></i> Giao hàng miễn phí cho đơn từ 5 triệu.</li>
                    </ul>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="input-group gv-qty" style="width:140px">
                        <button type="button" class="btn btn-outline-secondary" onclick="var q=document.getElementById('qty'); q.value=Math.max(1,parseInt(q.value||1)-1); q.dispatchEvent(new Event('change'))" aria-label="Giảm">−</button>
                        <input type="number" id="qty" value="1" min="1" class="form-control text-center" aria-label="Số lượng">
                        <button type="button" class="btn btn-outline-secondary" onclick="var q=document.getElementById('qty'); q.value=parseInt(q.value||1)+1; q.dispatchEvent(new Event('change'))" aria-label="Tăng">+</button>
                    </div>

                    <form method="post" class="buynow-form" action="{{ path('app_cart_add', {'product_id': data.getId()}) }}">
                        <input type="hidden" name="qty" class="qty-mirror" value="1">
                        <input type="hidden" name="buynow" value="1">
                        <button class="btn btn-danger btn-lg-cta px-4" type="submit" {{ data.isInStock() ? '' : 'disabled' }}>MUA NGAY</button>
                    </form>

                    <form method="post" class="add-to-cart-form" action="{{ path('app_cart_add', {'product_id': data.getId()}) }}">
                        <input type="hidden" name="qty" class="qty-mirror" value="1">
                        <button class="btn btn-outline-danger btn-lg-cta" type="submit" {{ data.isInStock() ? '' : 'disabled' }}><i class="bi bi-cart-plus"></i> Thêm vào giỏ</button>
                    </form>

                    <form method="post" class="wishlist-form" action="{{ path('app_wishlist_toggle', {'id': data.getId()}) }}">
                        <button type="submit" class="gv-wish-btn gv-wish-pd {{ inWish ? 'active' : '' }}" aria-label="Yêu thích" title="Thêm vào yêu thích"><i class="bi {{ inWish ? 'bi-heart-fill' : 'bi-heart' }}"></i></button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    {# Description + Specs #}
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="gv-section">
                {% if data.getDescription() %}
                    <div class="gv-section__head"><h2>Mô tả sản phẩm</h2></div>
                    <p>{{ data.getDescription() }}</p>
                {% endif %}
                {% if data.getSpecList() is not empty %}
                    <div class="gv-section__head mt-3"><h2>Thông số kỹ thuật</h2></div>
                    <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-0">
                        <tbody>
                            {% for spec in data.getSpecList() %}
                                <tr><th class="w-50 bg-light">{{ spec.0 }}</th><td>{{ spec.1 }}</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    </div>
                {% endif %}
            </div>

            {# Reviews #}
            <div class="gv-section">
                <div class="gv-section__head"><h2>Đánh giá sản phẩm</h2></div>
                {% if app.user %}
                    <form method="post" action="{{ path('app_review_add', {'id': data.getId()}) }}" class="border rounded p-3 mb-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('review_' ~ data.getId()) }}">
                        <div class="mb-2" style="max-width:220px">
                            <label for="rating" class="form-label mb-1">Chấm điểm</label>
                            <select name="rating" id="rating" class="form-select" required>
                                <option value="5">★★★★★ (5)</option>
                                <option value="4">★★★★ (4)</option>
                                <option value="3">★★★ (3)</option>
                                <option value="2">★★ (2)</option>
                                <option value="1">★ (1)</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label for="comment" class="form-label mb-1">Nhận xét</label>
                            <textarea name="comment" id="comment" class="form-control" rows="3" placeholder="Chia sẻ cảm nhận của bạn về sản phẩm..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-danger">Gửi đánh giá</button>
                    </form>
                {% else %}
                    <p class="text-muted"><a href="{{ path('app_login') }}">Đăng nhập</a> để viết đánh giá.</p>
                {% endif %}

                {% for review in reviews %}
                    <div class="border-bottom py-3">
                        <div class="text-warning">
                            {% for i in 1..5 %}<i class="bi {{ i <= review.rating ? 'bi-star-fill' : 'bi-star' }}"></i>{% endfor %}
                            <strong class="text-dark ms-2">{{ review.user ? review.user.firstName : 'Khách' }}</strong>
                            <small class="text-muted ms-2">{{ review.createdAt|date('d/m/Y') }}</small>
                        </div>
                        {% if review.comment %}<p class="mb-0 mt-1">{{ review.comment }}</p>{% endif %}
                    </div>
                {% else %}
                    <p class="text-muted">Chưa có đánh giá nào cho sản phẩm này.</p>
                {% endfor %}
            </div>

            <div class="gv-section">
                <div class="gv-section__head"><h2>Hỏi đáp về sản phẩm</h2></div>
                <form method="post" action="{{ path('app_question_add', {'id': data.getId()}) }}" class="border rounded p-3 mb-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('question_' ~ data.getId()) }}">
                    {% if not app.user %}
                    <div class="mb-2"><input type="text" name="author_name" class="form-control" placeholder="Tên của bạn" required></div>
                    {% endif %}
                    <div class="mb-2"><textarea name="content" class="form-control" rows="2" placeholder="Đặt câu hỏi về sản phẩm..." required></textarea></div>
                    <button type="submit" class="btn btn-outline-danger btn-sm">Gửi câu hỏi</button>
                </form>
                {% for q in questions %}
                    <div class="border-bottom py-3">
                        <div><i class="bi bi-question-circle text-danger"></i> <strong>{{ q.authorName }}</strong> <small class="text-muted">{{ q.createdAt|date('d/m/Y') }}</small></div>
                        <p class="mb-1">{{ q.content }}</p>
                        {% if q.isAnswered %}
                            <div class="ms-3 ps-2 border-start"><i class="bi bi-reply text-success"></i> <strong>TOÀN STORE:</strong> {{ q.answer }}</div>
                        {% else %}
                            <span class="badge bg-secondary">Chờ trả lời</span>
                        {% endif %}
                    </div>
                {% else %}
                    <p class="text-muted">Chưa có câu hỏi nào.</p>
                {% endfor %}
            </div>
        </div>

        {# Related #}
        <div class="col-lg-4">
            {% if related is not empty %}
            <div class="gv-section">
                <div class="gv-section__head"><h2 style="font-size:1rem">Sản phẩm liên quan</h2></div>
                {% for sp in related %}
                    <a href="{{ path('app_product', {'slug': sp.slug, 'id': sp.id}) }}" class="d-flex gap-2 align-items-center py-2 border-bottom text-body">
                        <img src="{{ asset('uploads/sanpham/' ~ sp.getPhoto()) }}" alt="{{ sp.getName() }}" style="width:56px;height:56px;object-fit:contain;border:1px solid var(--ts-border);border-radius:6px">
                        <div class="min-w-0">
                            <div class="line-clamp-2 small">{{ sp.getName() }}</div>
                            <div class="text-danger fw-bold small">{{ sp.getPrice()|vnd }}</div>
                        </div>
                    </a>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </div>
</div>

{% if recently_viewed is not empty %}
<div class="container-fluid px-3 px-xl-5 pb-3">
    <div class="gv-section">
        <div class="gv-section__head"><h2>Đã xem gần đây</h2></div>
        <div class="row g-3">
            {% for sp in recently_viewed %}
                <div class="col-6 col-md-4 col-lg-2">{% include 'partials/_product_card.html.twig' with {sp: sp, ratings: {}} %}</div>
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}

{# spacer + sticky add-to-cart bar (mobile) #}
<div class="d-lg-none" style="height:64px"></div>
<div class="detail-sticky-bar d-lg-none">
    <div class="d-flex align-items-center gap-2">
        <div class="flex-grow-1 min-w-0">
            <div class="line-clamp-1 small">{{ data.getName() }}</div>
            <div class="fw-bold text-danger">{{ data.getPrice()|vnd }}</div>
        </div>
        <form method="post" class="add-to-cart-form" action="{{ path('app_cart_add', {'product_id': data.getId()}) }}">
            <button class="btn btn-danger" type="submit" {{ data.isInStock() ? '' : 'disabled' }}><i class="bi bi-cart-plus"></i> Thêm</button>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<div class="ts-lightbox" id="lightbox"><img id="lightboxImg" src="" alt=""></div>
<script>
document.querySelectorAll('.thumb-img').forEach(function (t) {
    t.addEventListener('click', function () {
        var main = document.getElementById('mainImg');
        if (main) main.src = this.dataset.full;
        document.querySelectorAll('.thumb-img').forEach(function (x) { x.classList.remove('active'); });
        this.classList.add('active');
    });
});
// Lightbox zoom
(function () {
    var main = document.getElementById('mainImg');
    var box = document.getElementById('lightbox');
    var img = document.getElementById('lightboxImg');
    if (main && box) {
        main.addEventListener('click', function () { img.src = main.src; box.classList.add('open'); });
        box.addEventListener('click', function () { box.classList.remove('open'); });
    }
})();
// keep hidden qty inputs in sync with the quantity selector
var qty = document.getElementById('qty');
if (qty) qty.addEventListener('change', function () {
    document.querySelectorAll('.qty-mirror').forEach(function (m) { m.value = qty.value; });
});
</script>
{% endblock %}
