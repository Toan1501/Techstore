{% extends 'base.html.twig' %}

{% block title %}Đổi mật khẩu — TOÀN STORE{% endblock %}

{% block body %}
<div class="container py-4" style="max-width:520px">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('profile') }}">Tài khoản</a></li>
            <li class="breadcrumb-item active" aria-current="page">Đổi mật khẩu</li>
        </ol>
    </nav>

    <div class="auth-card">
        <div class="auth-card__head">
            <h1><i class="bi bi-shield-lock me-1"></i> Đổi mật khẩu</h1>
            <p>Nhập mật khẩu hiện tại và mật khẩu mới (tối thiểu 8 ký tự)</p>
        </div>
        <div class="auth-card__body">
            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('change_password') }}">
                <div class="mb-3">
                    <label for="current" class="form-label">Mật khẩu hiện tại</label>
                    <div class="input-group ts-field"><span class="input-group-text"><i class="bi bi-lock"></i></span><input type="password" id="current" name="current" class="form-control" autocomplete="current-password" required></div>
                </div>
                <div class="mb-3">
                    <label for="new" class="form-label">Mật khẩu mới</label>
                    <div class="input-group ts-field"><span class="input-group-text"><i class="bi bi-key"></i></span><input type="password" id="new" name="new" class="form-control" autocomplete="new-password" minlength="8" required></div>
                </div>
                <div class="mb-3">
                    <label for="confirm" class="form-label">Nhập lại mật khẩu mới</label>
                    <div class="input-group ts-field"><span class="input-group-text"><i class="bi bi-key-fill"></i></span><input type="password" id="confirm" name="confirm" class="form-control" autocomplete="new-password" minlength="8" required></div>
                </div>
                <button type="submit" class="btn btn-danger btn-lg-cta w-100"><i class="bi bi-check2-circle"></i> Cập nhật mật khẩu</button>
            </form>
            <p class="text-center mt-3 mb-0 small"><a href="{{ path('profile') }}" class="text-danger">&larr; Quay lại tài khoản</a></p>
        </div>
    </div>
</div>
{% endblock %}
