{% extends 'base.html.twig' %}

{% block title %}Tài khoản của tôi — TOÀN STORE{% endblock %}

{% block body %}
<div class="container py-4" style="max-width:820px">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Tài khoản của tôi</li>
        </ol>
    </nav>

    <div class="gv-section">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="d-flex align-items-center justify-content-center bg-danger text-white rounded-circle" style="width:64px;height:64px;font-size:1.8rem">
                <i class="bi bi-person-fill"></i>
            </div>
            <div>
                <h2 class="h5 mb-0">{{ user.firstname }} {{ user.lastname }}</h2>
                <span class="text-muted">@{{ user.username }}</span>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="text-muted small">Họ và tên</div>
                <div class="fw-medium">{{ user.firstname }} {{ user.lastname }}</div>
            </div>
            <div class="col-md-6">
                <div class="text-muted small">Email</div>
                <div class="fw-medium">{{ user.email ?: '—' }}</div>
            </div>
            <div class="col-md-6">
                <div class="text-muted small">Số điện thoại</div>
                <div class="fw-medium">{{ user.phonenumber }}</div>
            </div>
            <div class="col-md-6">
                <div class="text-muted small">Tài khoản</div>
                <div class="fw-medium">@{{ user.username }}</div>
            </div>
            <div class="col-12">
                <div class="text-muted small">Địa chỉ</div>
                <div class="fw-medium">{{ user.address }}</div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2 flex-wrap">
            <a href="{{ path('edit_profile') }}" class="btn btn-danger"><i class="bi bi-pencil me-1"></i>Chỉnh sửa thông tin</a>
            <a href="{{ path('app_my_orders') }}" class="btn btn-outline-danger"><i class="bi bi-bag me-1"></i>Đơn hàng của tôi</a>
            <a href="{{ path('change_password') }}" class="btn btn-outline-secondary"><i class="bi bi-key me-1"></i>Đổi mật khẩu</a>
        </div>
    </div>
</div>
{% endblock %}
