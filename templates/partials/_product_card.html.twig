{% set r = (ratings|default({}))[sp.id] ?? null %}
{% set inWish = sp.id in (app.session.get('wishlist')|default([])) %}
{% set inCompare = sp.id in (app.session.get('compare')|default([])) %}
<div class="gv-card">
    {% if sp.hasDiscount() %}<span class="gv-card__discount">-{{ sp.getDiscountPercent() }}%</span>{% endif %}
    <div class="gv-card__wish d-flex flex-column gap-1">
        <form method="post" class="wishlist-form" action="{{ path('app_wishlist_toggle', {'id': sp.id}) }}">
            <button type="submit" class="gv-wish-btn {{ inWish ? 'active' : '' }}" aria-label="Yêu thích"><i class="bi {{ inWish ? 'bi-heart-fill' : 'bi-heart' }}"></i></button>
        </form>
        <form method="post" class="compare-form" action="{{ path('app_compare_toggle', {'id': sp.id}) }}">
            <button type="submit" class="gv-wish-btn {{ inCompare ? 'active' : '' }}" aria-label="So sánh" title="So sánh"><i class="bi bi-arrow-left-right"></i></button>
        </form>
    </div>
    <a href="{{ path('app_product', {'slug': sp.slug, 'id': sp.id}) }}" class="gv-card__imgwrap">
        {% if not sp.isInStock() %}<span class="gv-card__soldout"><span>Hết hàng</span></span>{% endif %}
        <img src="{{ asset('uploads/sanpham/' ~ sp.getPhoto()) }}" alt="{{ sp.getName() }}" loading="lazy">
    </a>
    <div class="gv-card__body">
        <a class="gv-card__title line-clamp-2" href="{{ path('app_product', {'slug': sp.slug, 'id': sp.id}) }}" title="{{ sp.getName() }}">{{ sp.getName() }}</a>
        <div class="gv-card__price">
            <span class="gv-card__price-now">{{ sp.getPrice()|vnd }}</span>
            {% if sp.hasDiscount() %}<span class="gv-card__price-old">{{ sp.getPriceOld()|vnd }}</span>{% endif %}
        </div>
        <div class="gv-card__meta">
            {% include 'partials/_rating_stars.html.twig' with {avg: r ? r.average : 0, count: r ? r.count : 0} %}
            {% if sp.isInStock() %}<span class="text-success"><i class="bi bi-check-circle"></i> Còn hàng</span>{% else %}<span class="text-muted">Tạm hết</span>{% endif %}
        </div>
        {% if flash|default(false) %}
            {# Stock-level bar for flash-sale cards (relative to a 40-unit cap) #}
            {% set _w = sp.stock > 0 ? min(100, max(8, (sp.stock / 40) * 100)) : 0 %}
            <div class="gv-card__stockbar"><span style="--w: {{ _w|round }}%"></span></div>
            <div class="gv-card__stocktxt"><i class="bi bi-fire"></i> {{ sp.stock > 0 ? 'Còn ' ~ sp.stock ~ ' sản phẩm' : 'Đã bán hết' }}</div>
        {% endif %}
        <div class="gv-card__actions">
            <form method="post" class="add-to-cart-form" action="{{ path('app_cart_add', {'product_id': sp.getId()}) }}">
                <button class="btn btn-danger btn-sm w-100" type="submit" {{ sp.isInStock() ? '' : 'disabled' }}>
                    <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                </button>
            </form>
        </div>
    </div>
</div>
