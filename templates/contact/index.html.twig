{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Liên hệ — TECHSTORE{% endblock %}

{% block body %}
{% set st = store_settings() %}
<div class="container-fluid px-3 px-xl-5 py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Liên hệ</li>
        </ol>
    </nav>

    <div class="row g-3">
        <div class="col-lg-5">
            <div class="gv-section">
                <div class="gv-section__head"><h2>Thông tin liên hệ</h2></div>
                <div class="d-flex align-items-start gap-3 mb-3"><i class="bi bi-geo-alt-fill text-danger fs-4"></i><div><div class="fw-semibold">Địa chỉ</div><div class="text-muted">{{ st.address }}</div></div></div>
                <div class="d-flex align-items-start gap-3 mb-3"><i class="bi bi-headset text-danger fs-4"></i><div><div class="fw-semibold">Hotline</div><div class="text-muted">{{ st.hotline }}</div></div></div>
                <div class="d-flex align-items-start gap-3 mb-3"><i class="bi bi-envelope-fill text-danger fs-4"></i><div><div class="fw-semibold">Email</div><div class="text-muted">{{ st.email }}</div></div></div>
                <div class="d-flex align-items-start gap-3"><i class="bi bi-clock-fill text-danger fs-4"></i><div><div class="fw-semibold">Giờ làm việc</div><div class="text-muted">08:00 – 21:00 (T2 – CN)</div></div></div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="gv-section">
                <div class="gv-section__head"><h2>Gửi tin nhắn cho chúng tôi</h2></div>
                {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.name, 'Họ và tên') }}
                    <div class="input-group ts-field"><span class="input-group-text"><i class="bi bi-person"></i></span>{{ form_widget(form.name, {attr: {class: 'form-control'}}) }}</div>
                    {{ form_errors(form.name) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.email, 'Email') }}
                    <div class="input-group ts-field"><span class="input-group-text"><i class="bi bi-envelope"></i></span>{{ form_widget(form.email, {attr: {class: 'form-control'}}) }}</div>
                    {{ form_errors(form.email) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.message, 'Nội dung') }}
                    {{ form_widget(form.message, {attr: {class: 'form-control', rows: 5, placeholder: 'Nhập nội dung cần hỗ trợ...'}}) }}
                    {{ form_errors(form.message) }}
                </div>
                <button class="btn btn-danger btn-lg-cta" type="submit"><i class="bi bi-send"></i> Gửi liên hệ</button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
