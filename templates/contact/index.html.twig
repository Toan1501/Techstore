{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Liên hệ — TECHSTORE{% endblock %}

{% block body %}
<div class="container-fluid px-3 px-xl-5 py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Liên hệ</li>
        </ol>
    </nav>

    <div class="row g-3">
        <div class="col-lg-5">
            <div class="gv-section">
                <div class="gv-section__head"><h2>Thông tin liên hệ</h2></div>
                <p class="mb-2"><i class="bi bi-geo-alt text-danger me-2"></i>123 Lê Lợi, Quận 1, TP. Hồ Chí Minh</p>
                <p class="mb-2"><i class="bi bi-headset text-danger me-2"></i>Hotline: <strong>1900 5301</strong></p>
                <p class="mb-2"><i class="bi bi-envelope text-danger me-2"></i>support@techstore.vn</p>
                <p class="mb-0"><i class="bi bi-clock text-danger me-2"></i>08:00 – 21:00 (T2 – CN)</p>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="gv-section">
                <div class="gv-section__head"><h2>Gửi tin nhắn cho chúng tôi</h2></div>
                {{ form_start(form) }}
                {{ form_row(form.name, {label: 'Họ và tên'}) }}
                {{ form_row(form.email, {label: 'Email'}) }}
                {{ form_row(form.message, {label: 'Nội dung'}) }}
                <button class="btn btn-danger mt-2" type="submit">Gửi liên hệ</button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
