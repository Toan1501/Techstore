{% extends 'base.html.twig' %}

{% block title %}Khuyến mãi & mã giảm giá — TOÀN STORE{% endblock %}
{% block meta_description %}Tổng hợp sản phẩm đang giảm giá và mã giảm giá đang áp dụng tại Toàn Store: laptop, PC gaming, card đồ họa, màn hình, linh kiện chính hãng.{% endblock %}

{% block body %}
<div class="container-fluid px-3 px-xl-5 py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Khuyến mãi</li>
        </ol>
    </nav>

    {% if coupons is not empty %}
    <div class="gv-section">
        <div class="gv-section__head"><h2>Mã giảm giá đang áp dụng</h2></div>
        <div class="row g-3">
            {% for c in coupons %}
            <div class="col-md-6 col-lg-4">
                <div class="gv-coupon">
                    <div class="gv-coupon__left"><div class="gv-coupon__value">{{ c.label }}</div><small>GIẢM</small></div>
                    <div class="gv-coupon__body">
                        <div class="gv-coupon__code">{{ c.code }}</div>
                        <div class="small text-muted">
                            {% if c.minOrder > 0 %}Đơn từ {{ c.minOrder|vnd }}{% else %}Áp dụng mọi đơn hàng{% endif %}
                            {% if c.expiresAt %} · HSD {{ c.expiresAt|date('d/m/Y') }}{% endif %}
                            {% if c.maxUses %} · còn {{ c.maxUses - c.usageCount }} lượt{% endif %}
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger mt-2 js-copy" data-copy="{{ c.code }}"><i class="bi bi-clipboard"></i> Sao chép mã</button>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <div class="gv-section">
        <div class="gv-listing-bar">
            <div>
                <h1 class="gv-listing-title">Sản phẩm đang giảm giá</h1>
                <span class="text-muted small"><span data-countup="{{ data.getTotalItemCount }}">{{ data.getTotalItemCount }}</span> sản phẩm</span>
            </div>
            <form method="get" class="d-flex align-items-center gap-2">
                <label for="sortSel" class="form-label small mb-0 text-nowrap d-none d-sm-block">Sắp xếp:</label>
                <select name="sort" id="sortSel" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
                    <option value="discount" {{ sort == 'discount' ? 'selected' }}>Giảm nhiều nhất</option>
                    <option value="price_asc" {{ sort == 'price_asc' ? 'selected' }}>Giá thấp → cao</option>
                    <option value="price_desc" {{ sort == 'price_desc' ? 'selected' }}>Giá cao → thấp</option>
                    <option value="newest" {{ sort == 'newest' ? 'selected' }}>Mới nhất</option>
                </select>
            </form>
        </div>
        <div class="row g-3">
            {% for sp in data %}
                <div class="col-6 col-md-4 col-lg-3">
                    {% include 'partials/_product_card.html.twig' with {sp: sp, ratings: ratings|default({}), flash: true} %}
                </div>
            {% else %}
                <div class="col-12 text-center text-muted py-5"><i class="bi bi-tag" style="font-size:2.4rem"></i><p class="mt-3 mb-0">Hiện chưa có sản phẩm giảm giá.</p></div>
            {% endfor %}
        </div>
        {% if data.haveToPaginate is defined and data.haveToPaginate %}
            <div class="d-flex justify-content-center mt-4">{{ knp_pagination_render(data) }}</div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('click', function (e) {
    var b = e.target.closest('.js-copy'); if (!b) return;
    var code = b.getAttribute('data-copy');
    (navigator.clipboard ? navigator.clipboard.writeText(code) : Promise.reject()).then(function () {
        var o = b.innerHTML; b.innerHTML = '<i class="bi bi-check2"></i> Đã sao chép'; b.classList.add('btn-success', 'text-white');
        setTimeout(function () { b.innerHTML = o; b.classList.remove('btn-success', 'text-white'); }, 1500);
    }).catch(function () { window.prompt('Mã giảm giá:', code); });
});
</script>
{% endblock %}
