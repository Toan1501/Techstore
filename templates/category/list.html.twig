{% extends 'adbase.html.twig' %}

{% block title %}Danh sách danh mục{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Danh mục ({{ data|length }})</h6>
            <a href="{{ path('ad_category') }}" class="btn btn-sm btn-success"><i class="fas fa-plus"></i> Thêm danh mục</a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr><th>STT</th><th>Mã</th><th>Tên danh mục</th><th>Ảnh</th><th>Thao tác</th></tr>
                    </thead>
                    <tbody>
                        {% for cg in data %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td>{{ cg.getId() }}</td>
                            <td>{{ cg.getName() }}</td>
                            <td><img src="{{ asset('uploads/sanpham/' ~ cg.getPhoto()) }}" height="56" alt=""></td>
                            <td class="text-nowrap">
                                <a href="{{ path('app_edit_category', {'id': cg.getId()}) }}" class="btn btn-sm btn-warning">Sửa</a>
                                <form method="post" action="{{ path('app_delete_category', {'id': cg.getId()}) }}" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_category_' ~ cg.getId()) }}">
                                    <button class="btn btn-sm btn-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>function deletect(url){ if(confirm("Bạn có chắc muốn xóa danh mục này?")){ window.location.href = url; } }</script>
{% endblock %}
