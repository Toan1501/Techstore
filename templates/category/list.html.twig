{% extends 'adbase.html.twig' %}

{% block title %}Danh mục{% endblock %}
{% block subtitle %}{{ data|length }} danh mục · hiển thị theo thứ tự ưu tiên trên cửa hàng{% endblock %}
{% block actions %}<a href="{{ path('ad_category') }}" class="btn ad-btn ad-btn--red"><i class="bi bi-plus-lg"></i> Thêm danh mục</a>{% endblock %}

{% block body %}
<section class="ad-card">
    <div class="ad-table-wrap">
        <table class="ad-table">
            <thead><tr><th>Danh mục</th><th>Tên nội bộ</th><th class="num">Số sản phẩm</th><th class="actions"></th></tr></thead>
            <tbody>
                {% for cg in data %}
                    {% set edit = path('app_edit_category', {'id': cg.id}) %}
                    <tr data-href="{{ edit }}">
                        <td>
                            <div class="ad-prod">
                                <img class="ad-thumb" src="{{ asset('uploads/sanpham/' ~ cg.photo) }}" alt="">
                                <div><a href="{{ edit }}" class="ad-prod__name"><i class="bi bi-{{ cg.name|cat_icon }} me-1 text-danger"></i>{{ cg.name|cat_label }}</a><div class="ad-prod__meta">#{{ cg.id }}</div></div>
                            </div>
                        </td>
                        <td class="ad-muted ad-mono">{{ cg.name }}</td>
                        <td class="num"><a href="{{ path('app_ds_san_pham', {'cate': cg.id}) }}" class="ad-strong">{{ cg.sanPhams|length }}</a></td>
                        <td class="actions">
                            <div class="ad-row-actions">
                                <a href="{{ path('app_productofcate', {'id': cg.id}) }}" target="_blank" rel="noopener" class="ad-icon-btn" title="Xem trên cửa hàng" aria-label="Xem trên cửa hàng"><i class="bi bi-eye"></i></a>
                                <a href="{{ edit }}" class="ad-icon-btn" title="Sửa" aria-label="Sửa"><i class="bi bi-pencil"></i></a>
                                <form method="post" action="{{ path('app_delete_category', {'id': cg.id}) }}" data-confirm="Xóa danh mục “{{ cg.name|cat_label }}”? Chỉ xóa được khi danh mục không còn sản phẩm." data-confirm-ok="Xóa danh mục">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_category_' ~ cg.id) }}">
                                    <button class="ad-icon-btn ad-icon-btn--danger" title="Xóa" aria-label="Xóa"><i class="bi bi-trash3"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4"><div class="ad-empty"><i class="bi bi-diagram-3"></i><b>Chưa có danh mục</b><a href="{{ path('ad_category') }}">Tạo danh mục đầu tiên</a></div></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endblock %}
