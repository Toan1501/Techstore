{% extends 'adbase.html.twig' %}
{% form_theme category_form 'bootstrap_5_layout.html.twig' %}

{% block title %}Thêm / Sửa danh mục{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="card shadow mb-4" style="max-width:640px">
        <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Thông tin danh mục</h6></div>
        <div class="card-body">
            {{ form_start(category_form) }}
            {{ form_widget(category_form) }}
            <button type="submit" class="btn btn-success mt-2"><i class="fas fa-save"></i> Lưu danh mục</button>
            <a href="{{ path('app_ds_category') }}" class="btn btn-secondary mt-2">Hủy</a>
            {{ form_end(category_form) }}
        </div>
    </div>
</div>
{% endblock %}
