{% extends 'adbase.html.twig' %}
{% form_theme sp_form 'bootstrap_5_layout.html.twig' %}

{% block title %}Thêm / Sửa sản phẩm{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="card shadow mb-4" style="max-width:760px">
        <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Thông tin sản phẩm</h6></div>
        <div class="card-body">
            {{ form_start(sp_form) }}
            {{ form_widget(sp_form) }}
            <button type="submit" class="btn btn-success mt-2"><i class="fas fa-save"></i> Lưu sản phẩm</button>
            <a href="{{ path('app_ds_san_pham') }}" class="btn btn-secondary mt-2">Hủy</a>
            {{ form_end(sp_form) }}
        </div>
    </div>
</div>
{% endblock %}
