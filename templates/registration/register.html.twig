{% extends 'base.html.twig' %}
{% form_theme registrationForm 'bootstrap_5_layout.html.twig' %}

{% block title %}Đăng ký — TECHSTORE{% endblock %}

{% block body %}
<div class="container py-5" style="max-width:560px">
    <div class="gv-section">
        <h1 class="h4 text-center mb-4">Đăng ký tài khoản</h1>

        {{ form_errors(registrationForm) }}
        {{ form_start(registrationForm) }}
            <div class="row g-3">
                <div class="col-12">{{ form_row(registrationForm.username, {label: 'Tên đăng nhập'}) }}</div>
                <div class="col-md-6">{{ form_row(registrationForm.first_name, {label: 'Họ'}) }}</div>
                <div class="col-md-6">{{ form_row(registrationForm.last_name, {label: 'Tên'}) }}</div>
                <div class="col-12">{{ form_row(registrationForm.address, {label: 'Địa chỉ'}) }}</div>
                <div class="col-12">{{ form_row(registrationForm.phonenumber, {label: 'Số điện thoại'}) }}</div>
                <div class="col-12">{{ form_row(registrationForm.plainPassword, {label: 'Mật khẩu'}) }}</div>
                <div class="col-12">{{ form_row(registrationForm.agreeTerms, {label: 'Tôi đồng ý với điều khoản sử dụng'}) }}</div>
            </div>
            <button type="submit" class="btn btn-danger w-100 mt-2">Đăng ký</button>
        {{ form_end(registrationForm) }}

        <p class="text-center mt-3 mb-0">Đã có tài khoản? <a href="{{ path('app_login') }}">Đăng nhập</a></p>
    </div>
</div>
{% endblock %}
